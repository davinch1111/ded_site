---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'David Ediger Design — Creative Director',
  description = 'Twenty-three years of print, web, video, photo, and audio. Brands that refuse to blend in.',
} = Astro.props;

import IntroSequence from '../components/IntroSequence.tsx';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* Porsche-informed DED dark palette */
      --bg-dark:        #03040E;
      --bg-surface:     #111217;
      --bg-mid:         #1A1B22;
      --bg-light:       #F6F3EC;
      --text-primary:   #F5F4F0;
      --text-secondary: hsl(240 0.6% 67.3%);
      --text-dark:      #0F1014;
      --accent:         #3457C6;
      --accent-hover:   #2A47A0;

      /* ── Shared dark-UI tokens — single source of truth.
         Previously duplicated in index.astro (.hp) and
         work/[slug].astro (.work). ── */
      --black:      #03040E;
      --card-bg:    #141519;
      --white:      #FAFAFA;
      --text-white: #F5F4F0;
      --text-muted: rgba(245,244,240,0.5);
      --gap:        20px;

      /* Work / project-page surfaces */
      --w-bg:              #03040E;
      --w-surface:         #0F1116;
      --w-card:            #141519;
      --w-text:            #F5F4F0;
      --w-muted:           rgba(245,244,240,0.62);
      --w-faint:           rgba(245,244,240,0.5);
      --w-hairline:        rgba(255,255,255,0.09);
      --w-hairline-strong: rgba(255,255,255,0.16);
      --w-accent:          #3457C6;
      --w-accent-soft:     rgba(52,87,198,0.18);
      --w-ease-out:        cubic-bezier(0.23, 1, 0.32, 1);

      /* Legacy tokens — phased out component by component */
      --bg:      #F6F3EC;
      --blue:    #3457C6;
      --bluedk:  #2A47A0;
      --peri:    #90A5D1;
      --peridk:  #6E84B4;
      --sand:    #DDD3BC;
      --sandlt:  #EBE4D4;
      --slate:   #5A6269;
      --slatedk: #363D43;
      --taupe:   #A59A88;
      --taupedk: #8C8270;
      --midblue: #4A6FB5;

      --disp: 'Montserrat', sans-serif;
      --mid:  'Montserrat', sans-serif;
      --body: 'Montserrat', -apple-system, system-ui, sans-serif;
    }

    /* No global `scroll-behavior: smooth` — it makes mouse-wheel ticks
       animate, which reads as sticky/jerky scrolling. Modern browsers
       handle anchor jumps with a native instant scroll; if a specific
       link needs a smooth target, do it on the click handler. */

    body {
      background: var(--bg-dark);
      color: var(--text-primary);
      font-family: var(--body);
      font-weight: 400;
      line-height: 1.6;
      overflow-x: hidden;
    }

    img { max-width: 100%; display: block; }

    h1 {
      font-size: clamp(2rem, 3.5vw + 1.3rem, 5.5rem);
      letter-spacing: -0.01em;
      line-height: 1.05;
    }

    h2 {
      font-size: clamp(1.5rem, 2.5vw + 0.8rem, 3.5rem);
      letter-spacing: -0.01em;
      line-height: 1.1;
    }

    .lab {
      font-family: var(--body);
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }

    .wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 14px 24px;
      background: var(--accent);
      color: #fff;
      font-family: var(--body);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.06em;
      border-radius: 4px;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: transform 120ms ease-out, background 200ms cubic-bezier(.25,.1,.25,1);
    }
    .btn:hover { background: var(--accent-hover); }
    .btn:active { transform: scale(0.97); }

    /* Skip link — first focusable element on every page; jumps to #main */
    .skiplink {
      position: absolute;
      left: -9999px;
      top: 12px;
      background: var(--accent);
      color: #fff;
      padding: 10px 16px;
      border-radius: 4px;
      font-family: var(--body);
      font-size: 13px;
      z-index: 200;
      text-decoration: none;
    }
    .skiplink:focus { left: 12px; }

    /* Spotlight card — global because ::before can't be set from React inline styles */
    .spotlight-card {
      position: relative;
      border-radius: 0;
      overflow: hidden;
    }
    .spotlight-card::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 10;
      pointer-events: none;
      border-radius: inherit;
      background: radial-gradient(
        220px circle at var(--mx, -200px) var(--my, -200px),
        rgba(255, 255, 255, 0.10),
        transparent 70%
      );
    }

    @media (max-width: 1024px) {
      .wrap { padding: 0 28px; }
    }
    @media (max-width: 680px) {
      .wrap { padding: 0 20px; }
    }

    /* ── Intro overlay (IntroSequence.tsx) ──────────────────────────
       Lives here, not in a JSX <style> tag, because a runtime-injected
       inline style element is blocked by the strict CSP (style-src has
       no 'unsafe-inline'). The 800ms wipe must match WIPE_MS in
       src/components/IntroSequence.tsx. */
    .intro-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      /* Wipe uses a plain CSS transition. Browsers must paint a 0→100%
         inset on clip-path; if any browser short-circuits that paint,
         the visual is cut off but IntroSequence's setTimeout timeline
         stays correct. */
      clip-path: inset(0 0% 0 0%);
      transition: clip-path 800ms cubic-bezier(0.76, 0, 0.24, 1);
    }
    .intro-overlay.intro-wiping {
      clip-path: inset(0 0% 0 100%);
    }
    .intro-text {
      color: #fff;
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(14px, 2.4vw, 28px);
      font-weight: 300;
      text-transform: uppercase;
      letter-spacing: 0.5em;
      opacity: 0;
      filter: blur(12px);
      animation: introTextIn 1.2s ease-out 0.2s forwards;
    }
    @keyframes introTextIn {
      to {
        letter-spacing: 0.15em;
        filter: blur(0px);
        opacity: 1;
      }
    }
    .intro-badge {
      position: absolute;
      bottom: 40px;
      left: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 34px;
      border: 2px solid #fff;
      border-radius: 5px 5px 12px 12px;
      font-family: 'Montserrat', sans-serif;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: #fff;
      opacity: 0;
      animation: introBadgeIn 0.6s ease-out 0.6s forwards;
    }
    @keyframes introBadgeIn {
      to { opacity: 0.9; }
    }

    /* ── Scroll reveal ──────────────────────────────────────────────
       FAIL-SAFE: .reveal content is VISIBLE by default. The hidden-then-
       animate state below is gated on `html.js-reveal`, which the inline
       <head> script adds ONLY after it has confirmed IntersectionObserver
       exists and is wiring up the observer. So if JS is disabled, IO is
       unsupported, or the script never runs (blocked, errored, a stale
       dev-server module 504), nothing is ever hidden — content stays
       visible. The observer then adds .is-visible as elements scroll in. */
    html.js-reveal .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 800ms cubic-bezier(0.4, 0, 0.2, 1),
                  transform 800ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    html.js-reveal .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      html.js-reveal .reveal {
        transition: opacity 240ms ease;
        transform: none !important;
      }
    }
  </style>

  <slot name="head" />
</head>
<body>
  <IntroSequence client:load />
  <a href="#main" class="skiplink">Skip to content</a>
  <slot />

  <!-- Scroll-reveal observer (global; runs on every page via this layout).
       Adds `.js-reveal` to <html> ONLY after confirming IntersectionObserver
       support, which is what enables the hidden-then-animate CSS. If this
       script never runs — JS disabled, IO unsupported, a stale dev-server
       module — `.js-reveal` is never set and all .reveal content stays
       visible. The observer then reveals elements as they scroll into view. -->
  <script>
    if ('IntersectionObserver' in window) {
      document.documentElement.classList.add('js-reveal');
      const initReveal = () => {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
    }
  </script>
</body>
</html>
