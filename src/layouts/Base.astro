---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'David Ediger Design — Creative Director',
  description = 'Twenty-three years of print, web, video, photo, and audio. Brands that refuse to blend in.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <!-- Montserrat, self-hosted: single variable woff2 (weights 100–900, latin)
       — replaces the Google Fonts CDN (two origins gone). Icons are inline
       SVGs (src/components/Icon.astro) — the Font Awesome CDN is gone too. -->
  <link rel="preload" href="/fonts/montserrat-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face {
      font-family: 'Montserrat';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url('/fonts/montserrat-var-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* Porsche-informed DED dark palette */
      --bg-dark:        #03040E;
      --bg-surface:     #111217;
      --bg-mid:         #1A1B22;
      --bg-light:       #F6F3EC;
      --text-primary:   #F5F4F0;
      --text-secondary: hsl(240 0.6% 67.3%);
      --text-dark:      #0F1014;
      --accent:         #3457C6;
      --accent-hover:   #2A47A0;

      /* ── Shared dark-UI tokens — single source of truth.
         Previously duplicated in index.astro (.hp) and
         work/[slug].astro (.work). ── */
      --black:      #03040E;
      --card-bg:    #141519;
      --white:      #FAFAFA;
      --text-white: #F5F4F0;
      --text-muted: rgba(245,244,240,0.5);
      --gap:        20px;

      /* Work / project-page surfaces */
      --w-bg:              #03040E;
      --w-surface:         #0F1116;
      --w-card:            #141519;
      --w-text:            #F5F4F0;
      --w-muted:           rgba(245,244,240,0.62);
      --w-faint:           rgba(245,244,240,0.5);
      --w-hairline:        rgba(255,255,255,0.09);
      --w-hairline-strong: rgba(255,255,255,0.16);
      --w-accent:          #3457C6;
      --w-accent-soft:     rgba(52,87,198,0.18);
      --w-ease-out:        cubic-bezier(0.23, 1, 0.32, 1);

      /* Legacy tokens — phased out component by component */
      --bg:      #F6F3EC;
      --blue:    #3457C6;
      --bluedk:  #2A47A0;
      --peri:    #90A5D1;
      --peridk:  #6E84B4;
      --sand:    #DDD3BC;
      --sandlt:  #EBE4D4;
      --slate:   #5A6269;
      --slatedk: #363D43;
      --taupe:   #A59A88;
      --taupedk: #8C8270;
      --midblue: #4A6FB5;

      --disp: 'Montserrat', sans-serif;
      --mid:  'Montserrat', sans-serif;
      --body: 'Montserrat', -apple-system, system-ui, sans-serif;

      /* ── Type scale — the site's type hierarchy ────────────────────
         Established by ServicesSection.astro, currently the only consumer.
         NOT yet migrated (still hardcoding their own type): index.astro
         hero / work grid / about / testimonials / contact, SiteNav,
         SiteFooter, work/[slug].astro, work/index.astro.

         Weight 200 on the head token relies on the variable font's 100–900
         axis declared in the @font-face above. The two colour tokens are
         tuned for LIGHT backgrounds — a dark-background section must
         override --type-head-color / --type-body-color rather than
         inherit them. */
      --type-eyebrow-size:      10px;
      --type-eyebrow-weight:    500;
      --type-eyebrow-track:     0.28em;
      --type-eyebrow-transform: uppercase;
      --type-eyebrow-color:     var(--accent);

      --type-head-size:   clamp(34px, 5vw, 52px);
      --type-head-weight: 200;
      --type-head-track:  -0.035em;
      --type-head-color:  #8A8A8C;

      --type-item-size:   clamp(20px, 2.1vw, 22px);
      --type-item-weight: 400;
      --type-item-track:  -0.01em;

      --type-body-size:    13px;
      --type-body-weight:  300;
      --type-body-leading: 1.8;
      --type-body-color:   rgba(21, 22, 26, 0.55);

      --type-accent: var(--accent);
    }

    /* No global `scroll-behavior: smooth` — it makes mouse-wheel ticks
       animate, which reads as sticky/jerky scrolling. Modern browsers
       handle anchor jumps with a native instant scroll; if a specific
       link needs a smooth target, do it on the click handler. */

    body {
      background: var(--bg-dark);
      color: var(--text-primary);
      font-family: var(--body);
      font-weight: 400;
      line-height: 1.6;
      overflow-x: hidden;
    }

    img { max-width: 100%; display: block; }

    h1 {
      font-size: clamp(2rem, 3.5vw + 1.3rem, 5.5rem);
      letter-spacing: -0.01em;
      line-height: 1.05;
    }

    h2 {
      font-size: clamp(1.5rem, 2.5vw + 0.8rem, 3.5rem);
      letter-spacing: -0.01em;
      line-height: 1.1;
    }

    .lab {
      font-family: var(--body);
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }

    .wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 14px 24px;
      background: var(--accent);
      color: #fff;
      font-family: var(--body);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.06em;
      border-radius: 4px;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: transform 120ms ease-out, background 200ms cubic-bezier(.25,.1,.25,1);
    }
    .btn:hover { background: var(--accent-hover); }
    .btn:active { transform: scale(0.97); }

    /* Skip link — first focusable element on every page; jumps to #main */
    .skiplink {
      position: absolute;
      left: -9999px;
      top: 12px;
      background: var(--accent);
      color: #fff;
      padding: 10px 16px;
      border-radius: 4px;
      font-family: var(--body);
      font-size: 13px;
      z-index: 200;
      text-decoration: none;
    }
    .skiplink:focus { left: 12px; }

    /* Spotlight card — global because ::before can't be set from React inline styles */
    .spotlight-card {
      position: relative;
      border-radius: 0;
      overflow: hidden;
    }
    .spotlight-card::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 10;
      pointer-events: none;
      border-radius: inherit;
      background: radial-gradient(
        220px circle at var(--mx, -200px) var(--my, -200px),
        rgba(255, 255, 255, 0.10),
        transparent 70%
      );
    }

    @media (max-width: 1024px) {
      .wrap { padding: 0 28px; }
    }
    @media (max-width: 680px) {
      .wrap { padding: 0 20px; }
    }

    /* ── Intro overlay ──────────────────────────────────────────────
       Server-rendered as static markup in the <body> (see below) so it is
       opaque from the very first paint — no flash of the page before it
       covers. Shows the DED emblem centred with the wordmark directly below.

       FAIL-SAFE: the wipe is a CSS keyframe (introWipe) that plays on its
       own, so the overlay ALWAYS clears after the hold even if the intro
       script never runs and can never get stuck covering the site. The
       bundled script only adds bookkeeping (session guard, scroll lock,
       done event) and an instant-dismiss class for repeat visits.

       Timing: 3500ms hold + 800ms wipe = 4300ms total, encoded in the
       keyframe percentages and mirrored by INTRO_TOTAL_MS in the script. */
    .intro-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      clip-path: inset(0 0 0 0);
      animation: introWipe 4300ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
    }
    /* Hold fully covered through 81.4% (3500/4300), then wipe left→right. */
    @keyframes introWipe {
      0%, 81.4% { clip-path: inset(0 0 0 0); }
      100%      { clip-path: inset(0 0 0 100%); pointer-events: none; }
    }

    /* Repeat visit: removed instantly by the script. Reduced motion: hidden
       by the media query — both skip the intro with no animation, no flash. */
    .intro-overlay.is-dismissed {
      display: none !important;
      animation: none !important;
    }
    @media (prefers-reduced-motion: reduce) {
      .intro-overlay { display: none; }
    }

    .intro-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(16px, 2vw, 24px);
    }
    .intro-emblem {
      height: clamp(56px, 8vw, 92px);
      width: auto;
      opacity: 0;
      animation: introEmblemIn 0.8s ease-out 0.15s forwards;
    }
    @keyframes introEmblemIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 0.95; transform: translateY(0); }
    }
    .intro-text {
      color: #fff;
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(13px, 2.2vw, 22px);
      font-weight: 300;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      /* nudge right by ~half the trailing letter-spacing so the wordmark
         optically centres under the emblem */
      text-indent: 0.15em;
      opacity: 0;
      filter: blur(12px);
      animation: introTextIn 1.2s ease-out 0.3s forwards;
    }
    @keyframes introTextIn {
      from { letter-spacing: 0.5em;  filter: blur(12px); opacity: 0; }
      to   { letter-spacing: 0.15em; filter: blur(0);    opacity: 1; }
    }

    /* ── Scroll reveal ──────────────────────────────────────────────
       FAIL-SAFE: .reveal content is VISIBLE by default. The hidden-then-
       animate state below is gated on `html.js-reveal`, which the inline
       <head> script adds ONLY after it has confirmed IntersectionObserver
       exists and is wiring up the observer. So if JS is disabled, IO is
       unsupported, or the script never runs (blocked, errored, a stale
       dev-server module 504), nothing is ever hidden — content stays
       visible. The observer then adds .is-visible as elements scroll in. */
    html.js-reveal .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 800ms cubic-bezier(0.4, 0, 0.2, 1),
                  transform 800ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    html.js-reveal .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      html.js-reveal .reveal {
        transition: opacity 240ms ease;
        transform: none !important;
      }
    }
  </style>

  <slot name="head" />
</head>
<body>
  <!-- Intro overlay — static, server-rendered so it is opaque from first
       paint (no flash of the page underneath). The wipe is a CSS keyframe
       (fail-safe); the script below only handles the session guard, scroll
       lock, and the ded-intro-done event. -->
  <div id="intro-overlay" class="intro-overlay" role="presentation" aria-hidden="true">
    <div class="intro-stack">
      <img class="intro-emblem" src="/images/ded_emblem_white.svg" alt="" width="79" height="86" />
      <p class="intro-text">DAVID EDIGER DESIGN</p>
    </div>
  </div>

  <a href="#main" class="skiplink">Skip to content</a>
  <slot />

  <!-- Scroll-reveal observer (global; runs on every page via this layout).
       Adds `.js-reveal` to <html> ONLY after confirming IntersectionObserver
       support, which is what enables the hidden-then-animate CSS. If this
       script never runs — JS disabled, IO unsupported, a stale dev-server
       module — `.js-reveal` is never set and all .reveal content stays
       visible. The observer then reveals elements as they scroll into view. -->
  <script>
    if ('IntersectionObserver' in window) {
      document.documentElement.classList.add('js-reveal');
      const initReveal = () => {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
    }
  </script>

  <!-- Intro lifecycle. The wipe itself is the CSS keyframe on .intro-overlay,
       so the overlay always clears even if this script never runs. Here we
       only: skip the intro on repeat visits / reduced motion (instant
       dismiss), lock scroll while it plays, mark the session, and dispatch
       ded-intro-done for the hero entrances. Bundled (script-src 'self'),
       never inline. -->
  <script>
    // 3500ms hold + 800ms wipe — must match the introWipe keyframe.
    const INTRO_TOTAL_MS = 4300;
    const overlay = document.getElementById('intro-overlay');
    const fireIntroDone = (skipped) =>
      window.dispatchEvent(new CustomEvent('ded-intro-done', { detail: { skipped } }));

    if (!overlay) {
      fireIntroDone(true);
    } else {
      let seen = null;
      try { seen = sessionStorage.getItem('hasSeenIntro'); } catch {}
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (seen || reduced) {
        // Repeat visit or reduced motion: dismiss instantly, no animation.
        overlay.classList.add('is-dismissed');
        fireIntroDone(true);
      } else {
        try { sessionStorage.setItem('hasSeenIntro', '1'); } catch {}
        const prevOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        window.setTimeout(() => {
          document.body.style.overflow = prevOverflow;
          fireIntroDone(false);
        }, INTRO_TOTAL_MS);
      }
    }
  </script>

  <!-- Cloudflare Web Analytics — privacy-first, cookieless visitor tracking.
       External third-party beacon (not a bundled island): loaded from
       static.cloudflareinsights.com (in script-src) and it POSTs RUM data to
       cloudflareinsights.com/cdn-cgi/rum (in connect-src). The data-cf-beacon
       attribute makes Astro emit this tag verbatim (no inline hash needed). -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "e5110b0e5f2d418fa7d2a45c024096a5"}'></script>
</body>
</html>
