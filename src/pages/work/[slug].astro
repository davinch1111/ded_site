---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ScrollCue from '../../components/ScrollCue.astro';

// ─── Types ───────────────────────────────────────────────────────────────────
interface WPImage {
  ID?: number;
  id?: number;
  url: string;
  alt?: string;
  width?: number;
  height?: number;
  sizes?: Record<string, string | number>;
}
interface WPTerm { id: number; name: string; slug: string; taxonomy: string; }
interface GalleryItem { g_image: WPImage | false | null; g_title?: string; g_caption?: string; }
interface ACF {
  hero_animate?: boolean;
  master_image?: WPImage | false | null;
  project_logo?: WPImage | false | null;
  tagline?: string;
  fact_client?: string;
  fact_since?: string;
  fact_engagement?: string;
  fact_role?: string;
  show_brief?: boolean;
  brief_text?: string;
  show_approach?: boolean;
  approach_text?: string;
  show_gallery?: boolean;
  gallery_items?: GalleryItem[] | false;
  show_video?: boolean;
  video_url?: string;
  show_outcome?: boolean;
  outcome_text?: string;
  show_testimonial?: boolean;
  t_quote?: string;
  t_name?: string;
  t_role?: string;
  show_related?: boolean;
  related_projects?: number[] | false;
  show_cta?: boolean;
  cta_heading?: string;
}
interface ProjectLite {
  id: number;
  slug: string;
  title: string;
  featuredImage: string | null;
  discipline: WPTerm[];
  skill: WPTerm[];
}

// ─── Build-time fetch ────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const API_BASE = 'https://davidedigerdesign.in/wp-json/wp/v2';
  // orderby=menu_order: the drag-and-drop order (ASE Content Order). The
  // rest_ded_project_collection_params filter in ded-cpt.php allows it.
  const ENDPOINT = `${API_BASE}/ded_project?_embed&per_page=100&orderby=menu_order&order=asc`;

  let res: Response;
  try {
    res = await fetch(ENDPOINT, { signal: AbortSignal.timeout(12000) });
  } catch (e) {
    throw new Error(
      `[work/[slug]] Network error fetching ${ENDPOINT}: ${(e as Error).message}. ` +
      `WordPress at davidedigerdesign.in must be reachable at build time.`
    );
  }
  if (!res.ok) {
    throw new Error(
      `[work/[slug]] WP REST returned ${res.status} ${res.statusText} from ${ENDPOINT}. ` +
      `Cannot generate project pages.`
    );
  }
  const raw: any[] = await res.json();
  if (!Array.isArray(raw) || raw.length === 0) {
    throw new Error(`[work/[slug]] WP returned no projects. Aborting build to avoid silent empty site.`);
  }
  // WP returns them in menu_order (drag order) already — no client sort.

  // ── Collect all numeric image IDs across projects (handles legacy data
  //    where ACF stored attachment IDs before return_format=array was set on
  //    the matching field keys). Batch-resolve via the media endpoint.
  const ids = new Set<number>();
  const isNumericId = (v: any): v is number => typeof v === 'number' && Number.isFinite(v) && v > 0;
  for (const p of raw) {
    const a = p.acf ?? {};
    if (isNumericId(a.master_image)) ids.add(a.master_image);
    if (isNumericId(a.project_logo)) ids.add(a.project_logo);
    if (Array.isArray(a.gallery_items)) {
      for (const g of a.gallery_items) if (isNumericId(g?.g_image)) ids.add(g.g_image);
    }
  }

  const mediaMap = new Map<number, WPImage>();
  if (ids.size > 0) {
    const chunks: number[][] = [];
    const all = Array.from(ids);
    for (let i = 0; i < all.length; i += 80) chunks.push(all.slice(i, i + 80));
    for (const chunk of chunks) {
      const url = `${API_BASE}/media?include=${chunk.join(',')}&per_page=100&orderby=include`;
      const r = await fetch(url, { signal: AbortSignal.timeout(12000) });
      if (!r.ok) {
        throw new Error(`[work/[slug]] Failed to resolve media batch (${r.status}) from ${url}`);
      }
      const items: any[] = await r.json();
      for (const m of items) {
        mediaMap.set(m.id, {
          id: m.id,
          url: m.source_url,
          alt: m.alt_text ?? '',
          width: m.media_details?.width,
          height: m.media_details?.height,
          sizes: m.media_details?.sizes ? Object.fromEntries(
            Object.entries(m.media_details.sizes).map(([k, v]: [string, any]) => [k, v.source_url])
          ) : undefined,
        });
      }
    }
  }

  const resolveImg = (v: any): WPImage | null => {
    if (!v) return null;
    if (typeof v === 'object' && v.url) return v as WPImage;
    if (isNumericId(v)) return mediaMap.get(v) ?? null;
    return null;
  };

  // Build a slim siblings list for related-projects lookup on each page.
  const siblings: ProjectLite[] = raw.map((p: any) => {
    const terms: WPTerm[] = (p._embedded?.['wp:term'] ?? []).flat();
    return {
      id: p.id,
      slug: p.slug,
      title: p.title?.rendered ?? 'Untitled',
      featuredImage: p._embedded?.['wp:featuredmedia']?.[0]?.source_url ?? null,
      discipline: terms.filter(t => t.taxonomy === 'discipline'),
      skill:      terms.filter(t => t.taxonomy === 'skill'),
    };
  });

  return raw.map((p: any) => {
    const terms: WPTerm[] = (p._embedded?.['wp:term'] ?? []).flat();
    const a = (p.acf ?? {}) as ACF;
    // Rewrite any numeric image IDs to full WPImage objects.
    const acfResolved: ACF = {
      ...a,
      master_image: resolveImg(a.master_image),
      project_logo: resolveImg(a.project_logo),
      gallery_items: Array.isArray(a.gallery_items)
        ? a.gallery_items.map(g => ({ ...g, g_image: resolveImg(g.g_image) }))
        : a.gallery_items,
    };
    return {
      params: { slug: p.slug },
      props: {
        project: {
          id: p.id,
          slug: p.slug,
          title: (p.title?.rendered ?? 'Untitled') as string,
          acf: acfResolved,
          featuredImage: p._embedded?.['wp:featuredmedia']?.[0]?.source_url ?? null,
          discipline: terms.filter(t => t.taxonomy === 'discipline'),
          skill:      terms.filter(t => t.taxonomy === 'skill'),
        },
        siblings,
      },
    };
  });
}

const { project, siblings } = Astro.props;
const acf = project.acf;

// ─── Derived ─────────────────────────────────────────────────────────────────
const heroBg = (acf.master_image && (acf.master_image as WPImage).url)
  || project.featuredImage
  || null;

const heroAnimate = acf.hero_animate !== false;
const showFacts = !!(acf.fact_client || acf.fact_since || acf.fact_engagement || acf.fact_role);
const showBrief       = acf.show_brief       !== false && !!acf.brief_text;
const showApproach    = acf.show_approach    !== false && !!acf.approach_text;
const galleryItems    = Array.isArray(acf.gallery_items) ? acf.gallery_items.filter(g => g && g.g_image && (g.g_image as WPImage).url) : [];
const showGallery     = acf.show_gallery     !== false && galleryItems.length > 0;
const showVideo       = acf.show_video       === true  && !!acf.video_url;
const showOutcome     = acf.show_outcome     !== false && !!acf.outcome_text;
const showTestimonial = acf.show_testimonial === true  && !!acf.t_quote;
const showRelated     = acf.show_related     !== false;
const showCta         = acf.show_cta         !== false;
const skillsList      = project.skill;
const showSkills      = skillsList.length > 0;

// First visible content section — used as the hero scroll-cue target.
const firstSectionHref =
  showFacts       ? '#facts'       :
  showBrief       ? '#brief'       :
  showApproach    ? '#approach'    :
  showGallery     ? '#gallery'     :
  showVideo       ? '#video'       :
  showOutcome     ? '#outcome'     :
  showTestimonial ? '#testimonial' :
  showSkills      ? '#skills'      :
  '#related';

// Related: explicit IDs, else fall back to projects sharing a skill term, dedupe self.
let related: ProjectLite[] = [];
const explicitIds = Array.isArray(acf.related_projects) ? acf.related_projects : [];
if (explicitIds.length > 0) {
  related = explicitIds
    .map(id => siblings.find(s => s.id === id))
    .filter(Boolean) as ProjectLite[];
} else {
  const mySkills = new Set(project.skill.map(s => s.slug));
  related = siblings.filter(s =>
    s.id !== project.id && s.skill.some(sk => mySkills.has(sk.slug))
  );
}
related = related.filter(s => s.id !== project.id).slice(0, 2);

// Video URL → embed URL
function normalizeVideoEmbed(url: string): { type: 'iframe' | 'video'; src: string } {
  // YouTube
  let m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  if (m) return { type: 'iframe', src: `https://www.youtube-nocookie.com/embed/${m[1]}` };
  // Vimeo
  m = url.match(/vimeo\.com\/(\d+)/);
  if (m) return { type: 'iframe', src: `https://player.vimeo.com/video/${m[1]}` };
  // Direct mp4/webm (R2, etc.)
  return { type: 'video', src: url };
}
const video = showVideo && acf.video_url ? normalizeVideoEmbed(acf.video_url) : null;

// ─── SEO ─────────────────────────────────────────────────────────────────────
const cleanTitle  = project.title.replace(/&amp;/g, '&').replace(/<[^>]+>/g, '').trim();
const pageTitle   = `${cleanTitle} — David Ediger Design`;
const rawDesc     = (acf.tagline || acf.brief_text || `${cleanTitle}: creative work by David Ediger Design.`).replace(/<[^>]+>/g, '').trim();
const metaDesc    = rawDesc.length > 155 ? rawDesc.slice(0, 152).trimEnd() + '…' : rawDesc;
const ogImage     = heroBg || null;
const canonical   = `https://davidedigerdesign.com/work/${project.slug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  'name': cleanTitle,
  'description': metaDesc,
  'image': ogImage || undefined,
  'url': canonical,
  'creator': {
    '@type': 'Person',
    'name': 'David Ediger',
    'jobTitle': 'Creative Director',
    'worksFor': {
      '@type': 'Organization',
      'name': 'David Ediger Design',
      'url': 'https://davidedigerdesign.com/',
    },
  },
  'keywords': [...project.discipline, ...project.skill].map(t => t.name).join(', ') || undefined,
};
---

<Base title={pageTitle} description={metaDesc}>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <!-- Per-page SEO + OG/Twitter + JSON-LD -->
  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <SiteNav />

  <article class="work" data-slug={project.slug} data-animate={heroAnimate ? '1' : '0'} id="main">

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Hero -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <section class="w-hero" aria-label={`${cleanTitle} hero`}>
      {heroBg && (
        <div class="w-hero-bg-wrap">
          <img
            class="w-hero-bg"
            src={heroBg}
            alt={(acf.master_image as WPImage)?.alt || `${cleanTitle} hero image`}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
      <div class="w-hero-scrim"></div>

      <ScrollCue href={firstSectionHref} />

      <div class="w-hero-inner">
        {acf.project_logo && (acf.project_logo as WPImage).url && (
          <img
            class="w-project-logo"
            src={(acf.project_logo as WPImage).url}
            alt={(acf.project_logo as WPImage).alt || `${cleanTitle} logo`}
            width={(acf.project_logo as WPImage).width || undefined}
            height={(acf.project_logo as WPImage).height || undefined}
          />
        )}

        {acf.fact_client && (
          <p class="w-hero-eyebrow">{acf.fact_client}</p>
        )}

        <h1 class="w-hero-h1" set:html={acf.tagline || cleanTitle} />

        {project.discipline.length > 0 && (
          <ul class="w-pills" aria-label="Disciplines">
            {project.discipline.map(t => (
              <li class="w-pill">{t.name}</li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Quick facts -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showFacts && (
      <section class="w-facts reveal" id="facts" aria-label="Project facts">
        <div class="w-wrap">
          <dl class="w-facts-row">
            {acf.fact_client && (
              <div class="w-fact">
                <dt>Client</dt>
                <dd>{acf.fact_client}</dd>
              </div>
            )}
            {acf.fact_since && (
              <div class="w-fact">
                <dt>Since</dt>
                <dd>{acf.fact_since}</dd>
              </div>
            )}
            {acf.fact_engagement && (
              <div class="w-fact">
                <dt>Engagement</dt>
                <dd>{acf.fact_engagement}</dd>
              </div>
            )}
            {acf.fact_role && (
              <div class="w-fact">
                <dt>Role</dt>
                <dd>{acf.fact_role}</dd>
              </div>
            )}
          </dl>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Brief — label left, copy right -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showBrief && (
      <section class="w-blocked w-blocked--left reveal" id="brief" aria-labelledby="brief-h">
        <div class="w-wrap">
          <span class="w-index" aria-hidden="true">01</span>
          <div class="w-blocked-grid">
            <header class="w-blocked-label">
              <p class="w-eyebrow">The brief</p>
              <h2 id="brief-h" class="w-h2">Where it started</h2>
            </header>
            <div class="w-blocked-body">
              <p>{acf.brief_text}</p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Approach — copy left, label right, accent glow -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showApproach && (
      <section class="w-blocked w-blocked--right w-blocked--glow reveal" id="approach" aria-labelledby="approach-h">
        <div class="w-glow" aria-hidden="true"></div>
        <div class="w-wrap">
          <span class="w-index w-index--right" aria-hidden="true">02</span>
          <div class="w-blocked-grid w-blocked-grid--right">
            <div class="w-blocked-body">
              <p>{acf.approach_text}</p>
            </div>
            <header class="w-blocked-label w-blocked-label--right">
              <p class="w-eyebrow">The approach</p>
              <h2 id="approach-h" class="w-h2">How I tackled it</h2>
            </header>
          </div>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Gallery — mixed proportions -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showGallery && (
      <section class="w-gallery reveal" id="gallery" aria-labelledby="gallery-h">
        <div class="w-wrap">
          <header class="w-gallery-head">
            <p class="w-eyebrow">The work</p>
            <h2 id="gallery-h" class="w-h2">What I made</h2>
          </header>

          <div class="w-gallery-stack">
            {galleryItems.map((item, i) => {
              const img = item.g_image as WPImage;
              const total = galleryItems.length;
              const isFirst = i === 0;
              // Pair index after the first: 0,1 then 2,3 then 4,5...
              // first item of each pair = wide-left, second = wide-right
              const pairIdx = (i - 1);
              const isWideLeft  = !isFirst && pairIdx % 2 === 0;
              const isWideRight = !isFirst && pairIdx % 2 === 1;
              // The last orphan item (odd count after the hero) → full-width.
              const isOrphan = !isFirst && i === total - 1 && (total - 1) % 2 === 1;

              if (isFirst || isOrphan) {
                return (
                  <figure class="w-g-card w-g-card--full reveal">
                    <button class="w-g-trigger" type="button" data-lb-index={i}
                      data-lb-caption={[item.g_title, item.g_caption].filter(Boolean).join(' — ')}
                      aria-label={`View larger: ${item.g_title || `${cleanTitle} image ${i + 1}`}`}>
                      <img src={img.url} alt={img.alt || item.g_title || `${cleanTitle} gallery item ${i + 1}`} loading={i < 2 ? 'eager' : 'lazy'} />
                    </button>
                    {(item.g_title || item.g_caption) && (
                      <figcaption>
                        {item.g_title && <strong>{item.g_title}</strong>}
                        {item.g_caption && <span>{item.g_caption}</span>}
                      </figcaption>
                    )}
                  </figure>
                );
              }
              // pair start (wide-left)
              if (isWideLeft) {
                const next = galleryItems[i + 1];
                const nextImg = next?.g_image as WPImage | undefined;
                return (
                  <div class="w-g-pair w-g-pair--wide-left reveal">
                    <figure class="w-g-card">
                      <button class="w-g-trigger" type="button" data-lb-index={i}
                        data-lb-caption={[item.g_title, item.g_caption].filter(Boolean).join(' — ')}
                        aria-label={`View larger: ${item.g_title || `${cleanTitle} image ${i + 1}`}`}>
                        <img src={img.url} alt={img.alt || item.g_title || `${cleanTitle} gallery item ${i + 1}`} loading="lazy" />
                      </button>
                      {(item.g_title || item.g_caption) && (
                        <figcaption>
                          {item.g_title && <strong>{item.g_title}</strong>}
                          {item.g_caption && <span>{item.g_caption}</span>}
                        </figcaption>
                      )}
                    </figure>
                    {next && nextImg && (
                      <figure class="w-g-card">
                        <button class="w-g-trigger" type="button" data-lb-index={i + 1}
                          data-lb-caption={[next.g_title, next.g_caption].filter(Boolean).join(' — ')}
                          aria-label={`View larger: ${next.g_title || `${cleanTitle} image ${i + 2}`}`}>
                          <img src={nextImg.url} alt={nextImg.alt || next.g_title || `${cleanTitle} gallery item ${i + 2}`} loading="lazy" />
                        </button>
                        {(next.g_title || next.g_caption) && (
                          <figcaption>
                            {next.g_title && <strong>{next.g_title}</strong>}
                            {next.g_caption && <span>{next.g_caption}</span>}
                          </figcaption>
                        )}
                      </figure>
                    )}
                  </div>
                );
              }
              // even index inside a pair is rendered by its predecessor (wide-left). Skip.
              return null;
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Video (16:9 responsive) -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showVideo && video && (
      <section class="w-video reveal" id="video" aria-labelledby="video-h">
        <div class="w-wrap">
          <header class="w-video-head">
            <p class="w-eyebrow">In motion</p>
            <h2 id="video-h" class="w-h2">See it move</h2>
          </header>
          <div class="w-video-frame">
            {video.type === 'iframe' ? (
              <iframe
                src={video.src}
                title={`${cleanTitle} project video`}
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              />
            ) : (
              <video src={video.src} controls playsinline preload="metadata" aria-label={`${cleanTitle} project video`} />
            )}
          </div>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Outcome -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showOutcome && (
      <section class="w-outcome reveal" id="outcome" aria-labelledby="outcome-h">
        <div class="w-wrap">
          <p class="w-eyebrow">The outcome</p>
          <h2 id="outcome-h" class="w-h2">How it landed</h2>
          <p class="w-outcome-statement">{acf.outcome_text}</p>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Testimonial -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showTestimonial && (
      <section class="w-testimonial reveal" id="testimonial" aria-label="Client testimonial">
        <div class="w-wrap">
          <blockquote class="w-quote-card">
            <span class="w-quote-mark" aria-hidden="true">“</span>
            <p class="w-quote-text">{acf.t_quote}</p>
            {(acf.t_name || acf.t_role) && (
              <footer class="w-quote-meta">
                {acf.t_name && <span class="w-quote-name">{acf.t_name}</span>}
                {acf.t_role && <span class="w-quote-role">{acf.t_role}</span>}
              </footer>
            )}
          </blockquote>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Skills used -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showSkills && (
      <section class="w-skills reveal" id="skills" aria-labelledby="skills-h">
        <div class="w-wrap">
          <p class="w-eyebrow">What it took</p>
          <h2 id="skills-h" class="w-h2">Skills used</h2>
          <ul class="w-pills" aria-label="Skills used on this project">
            {skillsList.map(t => <li class="w-pill w-pill--ghost">{t.name}</li>)}
          </ul>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- Related projects -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showRelated && related.length > 0 && (
      <section class="w-related reveal" id="related" aria-labelledby="related-h">
        <div class="w-wrap">
          <header class="w-related-head">
            <p class="w-eyebrow">Keep going</p>
            <h2 id="related-h" class="w-h2">More work</h2>
          </header>
          <div class="w-related-grid">
            {related.map(r => (
              <a class="w-related-card" href={`/work/${r.slug}/`} aria-label={`View project: ${r.title.replace(/<[^>]+>/g,'')}`}>
                {r.featuredImage && (
                  <img class="w-related-img" src={r.featuredImage} alt={r.title.replace(/<[^>]+>/g,'')} loading="lazy" />
                )}
                <div class="w-related-overlay">
                  <div class="w-related-meta">
                    {r.discipline.length > 0 && (
                      <ul class="w-pills w-pills--sm" aria-hidden="true">
                        {r.discipline.slice(0, 3).map(t => <li class="w-pill w-pill--ghost">{t.name}</li>)}
                      </ul>
                    )}
                    <h3 class="w-related-title" set:html={r.title} />
                  </div>
                  <span class="w-related-arrow" aria-hidden="true">
                    <i class="fa-solid fa-arrow-right"></i>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!-- CTA -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    {showCta && (
      <section class="w-cta reveal" aria-labelledby="cta-h">
        <div class="w-wrap">
          <h2 id="cta-h" class="w-cta-h">
            {acf.cta_heading || "Got a project like this one?"}
          </h2>
          <a href="/#contact" class="w-cta-btn">
            Tell me what you're building
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </section>
    )}

  </article>

  {/* Lightbox overlay — additive; hidden until a thumbnail is clicked. Placed
      at page top level (NOT inside a .reveal section) because a transformed
      ancestor would make position:fixed resolve to that ancestor instead of
      the viewport. If the script never runs it stays hidden and the gallery
      thumbnails remain normal inline images. */}
  {showGallery && (
    <div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label={`${cleanTitle} gallery viewer`} hidden>
      <button class="lb-close" type="button" aria-label="Close image viewer">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <button class="lb-nav lb-prev" type="button" aria-label="Previous image">
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <figure class="lb-figure">
        <img class="lb-img" alt="" />
        <figcaption class="lb-cap" aria-live="polite"></figcaption>
      </figure>
      <button class="lb-nav lb-next" type="button" aria-label="Next image">
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
  )}

  <SiteFooter />

</Base>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════════════
     WORK / PROJECT PAGE
     Reuses Base.astro tokens (--bg-dark, --text-primary, --accent, Montserrat).
     Adds its own scoped palette for surfaces, hairlines, and the accent glow.
     ═══════════════════════════════════════════════════════════════════════ */

  /* Design tokens (--w-*) now live in Base.astro :root. */
  .work {
    background: var(--w-bg);
    color: var(--w-text);
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
  }

  /* Skip link styles now live globally in Base.astro */

  /* Shared wrap */
  .work .w-wrap {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 100px);
    position: relative;
  }

  /* Shared typography */
  .work .w-eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--w-faint);
    margin-bottom: 14px;
  }
  .work .w-h2 {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.6rem, 2.4vw + 0.4rem, 2.8rem);
    font-weight: 300;
    letter-spacing: -0.018em;
    line-height: 1.1;
    color: var(--w-text);
    text-wrap: balance;
  }

  /* Pills (Porsche-style) */
  .work .w-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0;
  }
  .work .w-pill {
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--w-text);
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--w-hairline);
    padding: 8px 14px;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .work .w-pill--ghost {
    background: transparent;
    color: var(--w-muted);
    border-color: var(--w-hairline-strong);
  }
  .work .w-pills--sm .w-pill { font-size: 10px; padding: 6px 11px; }

  /* ─── HERO ─────────────────────────────────────────────────────────────── */
  .w-hero {
    position: relative;
    /* Shorter than a full viewport so the quick-facts row clears the fold
       and sits close under the discipline pills. */
    min-height: clamp(520px, 74svh, 760px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(104px, 12vh, 168px) 0 clamp(32px, 4.5vh, 56px);
  }
  .w-hero-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .w-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform: scale(1.06);
  }
  .w-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(3,4,14,0.35) 0%, rgba(3,4,14,0.1) 22%, rgba(3,4,14,0.55) 65%, rgba(3,4,14,0.95) 100%),
      radial-gradient(120% 60% at 50% 100%, rgba(3,4,14,0.6) 0%, transparent 70%);
  }
  .w-hero-inner {
    position: relative;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 100px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .w-project-logo {
    align-self: flex-start;
    /* Normalize every project logo into one consistent box. Logos vary
       wildly in aspect (FLF ~7.6:1 wide lockup vs Innotech ~2.3:1 stacked
       badge); sizing by height alone let the wide marks stretch across the
       hero. A fixed 56px box height + width cap + object-fit:contain keeps
       all logos at a balanced size regardless of source proportions —
       wide lockups are width-capped and letterboxed, squarer marks fill. */
    height: 56px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    object-position: left center;
    margin-bottom: 4px;
    opacity: 0.95;
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.4));
  }
  .w-hero-eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245,244,240,0.78);
  }
  .w-hero-h1 {
    font-family: 'Montserrat', sans-serif;
    /* Smaller than before (was 4.8vw+0.4rem, max 5.6rem) — lower fluid and
       max terms so the title reads noticeably smaller and wraps more
       gracefully while still dominating the hero. */
    font-size: clamp(2.1rem, 3.6vw + 0.3rem, 4.3rem);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.04;
    color: var(--w-text);
    text-wrap: balance;
    max-width: 18ch;
  }
  .w-hero .w-pills { margin-top: 12px; }

  /* Scroll cue lives in src/components/ScrollCue.astro */

  /* ─── FACTS ─────────────────────────────────────────────────────────────── */
  .w-facts {
    /* Tight top padding so the facts sit just under the pills, above the fold. */
    padding: clamp(24px, 3.5vh, 40px) 0 clamp(32px, 5vh, 64px);
    background: var(--w-bg);
  }
  /* Four evenly-distributed columns across the content width, flush to the
     same left/right edges as the hero copy, separated by consistent gaps. */
  .w-facts-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 3vw, 48px);
    border-top: 1px solid var(--w-hairline);
    border-bottom: 1px solid var(--w-hairline);
  }
  .w-fact {
    padding: clamp(20px, 3vh, 28px) 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .w-fact dt {
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--w-faint);
  }
  .w-fact dd {
    font-family: 'Montserrat', sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: var(--w-text);
    margin: 0;
  }
  @media (max-width: 720px) {
    .w-facts-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .w-facts-row { grid-template-columns: 1fr; }
  }

  /* ─── BLOCKED (brief + approach) ───────────────────────────────────────── */
  .w-blocked {
    position: relative;
    padding: clamp(64px, 9vh, 120px) 0;
    overflow: hidden;
  }
  .w-blocked--glow .w-glow {
    position: absolute;
    inset: auto -10% 10% auto;
    width: 80vmax;
    height: 80vmax;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--w-accent-soft) 0%, transparent 70%);
    z-index: 0;
    filter: blur(20px);
  }
  .w-blocked .w-wrap { z-index: 1; }
  .w-index {
    position: absolute;
    top: 50%;
    left: clamp(-24px, -1vw, -8px);
    transform: translateY(-50%);
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: clamp(180px, 28vw, 360px);
    line-height: 0.85;
    color: rgba(245,244,240,0.055);
    letter-spacing: -0.04em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .w-index--right { left: auto; right: clamp(-24px, -1vw, -8px); }

  .w-blocked-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(40px, 6vw, 120px);
    align-items: start;
  }
  .w-blocked-grid--right { grid-template-columns: 1.6fr 1fr; }

  .w-blocked-label .w-eyebrow,
  .w-blocked-label .w-h2 { text-align: left; }
  .w-blocked-label--right { text-align: right; }
  .w-blocked-label--right .w-eyebrow,
  .w-blocked-label--right .w-h2 { text-align: right; }

  .w-blocked-body {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.05rem, 1vw + 0.55rem, 1.4rem);
    font-weight: 300;
    line-height: 1.55;
    color: var(--w-muted);
    max-width: 60ch;
  }
  .w-blocked-body p + p { margin-top: 1em; }

  @media (max-width: 880px) {
    .w-blocked-grid,
    .w-blocked-grid--right { grid-template-columns: 1fr; gap: 28px; }
    .w-blocked-label--right { text-align: left; }
    .w-blocked-label--right .w-eyebrow,
    .w-blocked-label--right .w-h2 { text-align: left; }
    .w-blocked--right .w-blocked-grid--right > * { order: 0; }
    .w-blocked--right .w-blocked-grid--right .w-blocked-label { order: -1; }
    .w-index { font-size: clamp(140px, 36vw, 220px); }
  }

  /* ─── GALLERY ──────────────────────────────────────────────────────────── */
  .w-gallery {
    padding: clamp(64px, 9vh, 120px) 0;
    background: var(--w-bg);
  }
  .w-gallery-head { margin-bottom: clamp(28px, 4vh, 44px); }

  .w-gallery-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 40px);
  }
  /* Pair height is PINNED so the column-grow hover doesn't reflow the
     gallery vertically. Without a fixed height the card image's
     intrinsic aspect-ratio drove card height — when a column widened
     on hover, the card grew taller, the row got taller, and every
     row below got "nudged" down. Pinning the height makes each pair
     animate in complete layout isolation, mirroring how the homepage
     .work-row { height: 600px } stays still while its columns shift. */
  .w-g-pair {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    height: clamp(360px, 40vh, 520px);
  }
  /* Higher specificity (.work .w-gallery .w-g-pair) so this transition
     beats `.work .reveal`'s shorthand, which would otherwise clobber
     `grid-template-columns` with `opacity, transform`. Column-grow at
     750ms cubic-bezier(.4,0,.2,1) — slower than the homepage's 550ms
     for a classier, more deliberate feel on these larger surfaces.
     Opacity + transform carried alongside so the reveal entrance
     still plays. */
  .work .w-gallery .w-g-pair {
    transition:
      grid-template-columns 750ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity   800ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 800ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .w-g-pair--wide-left  { grid-template-columns: 1.3fr 1fr; }
  .w-g-pair--wide-right { grid-template-columns: 1fr 1.3fr; }

  /* Column-grow on hover. Hovered card grows, neighbour shrinks.
     Row height stays pinned so the gallery never reflows vertically. */
  .w-g-pair:has(.w-g-card:nth-child(1):hover) { grid-template-columns: 1.6fr 0.6fr; }
  .w-g-pair:has(.w-g-card:nth-child(2):hover) { grid-template-columns: 0.6fr 1.6fr; }

  .w-g-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--w-card);
    box-shadow: 0 30px 60px -24px rgba(6,10,30,0.8);
    isolation: isolate;
    height: 100%;
  }
  /* Full-width gallery cards sit alone in the stack — no neighbour to
     nudge. Keep the 16:10 aspect-ratio for their visible proportions.
     Paired cards fill their pair's pinned height. */
  .w-g-card--full {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
  }
  .w-g-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Image zoom timing matches the column-grow (750ms) so a hover that
       coincides with a neighbour row's column shift reads as one
       coordinated motion, not two competing animations. */
    transition: transform 750ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .w-g-card--full:hover img { transform: scale(1.04); }
  }
  .w-g-card figcaption {
    padding: 18px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: linear-gradient(180deg, rgba(20,21,25,0) 0%, rgba(20,21,25,0.92) 100%);
    color: var(--w-muted);
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
  }
  .w-g-card figcaption strong {
    color: var(--w-text);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.005em;
  }

  @media (max-width: 880px) {
    .w-g-pair,
    .w-g-pair--wide-left,
    .w-g-pair--wide-right {
      grid-template-columns: 1fr;
      height: auto;
      transition: none;
    }
    .w-g-pair:has(.w-g-card:nth-child(1):hover),
    .w-g-pair:has(.w-g-card:nth-child(2):hover) { grid-template-columns: 1fr; }
    /* Each stacked card gets its own aspect-ratio so the cards aren't
       a single squished block. */
    .w-g-pair > .w-g-card {
      height: auto;
      aspect-ratio: 16 / 10;
    }
  }

  /* Gallery image becomes a lightbox trigger — a transparent full-size
     wrapper around the (still-visible) thumbnail. */
  .w-g-trigger {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .w-g-trigger:focus-visible {
    outline: 2px solid var(--w-accent);
    outline-offset: -3px;
  }

  /* ─── LIGHTBOX ─────────────────────────────────────────────────────────── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(3, 4, 14, 0.85);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .lb[hidden] { display: none; }
  .lb.is-open { opacity: 1; }

  /* Figure is non-interactive so clicks in the gaps reach the scrim (close);
     the image + caption re-enable pointer events. */
  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: calc(100vw - 140px);
    pointer-events: none;
  }
  .lb-img {
    max-width: calc(100vw - 140px);
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9);
    pointer-events: auto;
    transform: translateX(0);
    opacity: 1;
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1),
                opacity 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lb-noanim    { transition: none !important; }
  .lb-out-next  { transform: translateX(-40px); opacity: 0; }
  .lb-out-prev  { transform: translateX(40px);  opacity: 0; }
  .lb-enter-next{ transform: translateX(40px);  opacity: 0; }
  .lb-enter-prev{ transform: translateX(-40px); opacity: 0; }

  .lb-cap {
    pointer-events: auto;
    color: var(--w-muted);
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    text-align: center;
    max-width: 60ch;
  }
  .lb-cap:empty { display: none; }

  .lb-close, .lb-nav {
    position: fixed;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(245, 244, 240, 0.3);
    background: rgba(255, 255, 255, 0.06);
    color: var(--w-text);
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }
  .lb-close:hover, .lb-nav:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(245, 244, 240, 0.6);
  }
  .lb-close:focus-visible, .lb-nav:focus-visible {
    outline: 2px solid var(--w-accent);
    outline-offset: 3px;
  }
  .lb-close {
    top: clamp(16px, 3vw, 28px);
    right: clamp(16px, 3vw, 28px);
    width: 48px; height: 48px; font-size: 18px;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 52px; height: 52px; font-size: 18px;
  }
  .lb-prev { left: clamp(12px, 3vw, 32px); }
  .lb-next { right: clamp(12px, 3vw, 32px); }
  .lb-nav:hover { transform: translateY(-50%) scale(1.05); }
  .lb-nav[hidden] { display: none; }

