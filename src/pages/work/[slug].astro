<script>
  // ─── Motion ──────────────────────────────────────────────────────────────
  const root = document.querySelector('.work') as HTMLElement | null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) {
    const heroAnimate = root.getAttribute('data-animate') === '1';

    // Hero entrance — GSAP if available + opted in + motion allowed.
    // Wait for the intro overlay to finish wiping before firing, so the
    // entrance is actually visible. If the intro has already been seen
    // this session (sessionStorage), fire immediately.
    if (heroAnimate && !reducedMotion) {
      const runHeroEntrance = async () => {
        try {
          const { gsap } = await import('gsap');

          const heroBg = root.querySelector('.w-hero-bg') as HTMLElement | null;
          const eyebrow = root.querySelector('.w-hero-eyebrow') as HTMLElement | null;
          const logo = root.querySelector('.w-project-logo') as HTMLElement | null;
          const h1 = root.querySelector('.w-hero-h1') as HTMLElement | null;
          const pills = root.querySelectorAll('.w-hero .w-pill');

          const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

          if (heroBg) {
            tl.fromTo(heroBg,
              { scale: 1.12, opacity: 0.6 },
              { scale: 1.0, opacity: 1, duration: 2.4, ease: 'expo.out' },
              0
            );
          }
          if (logo) {
            tl.fromTo(logo,
              { y: 12, opacity: 0 },
              { y: 0, opacity: 0.95, duration: 0.8 },
              0.15
            );
          }
          if (eyebrow) {
            tl.fromTo(eyebrow,
              { y: 14, opacity: 0 },
              { y: 0, opacity: 1, duration: 0.7 },
              0.2
            );
          }
          if (h1) {
            tl.fromTo(h1,
              { y: 28, opacity: 0 },
              { y: 0, opacity: 1, duration: 1.0 },
              0.28
            );
          }
          if (pills.length) {
            tl.fromTo(pills,
              { y: 14, opacity: 0 },
              { y: 0, opacity: 1, duration: 0.6, stagger: 0.05 },
              0.5
            );
          }
        } catch {
          /* GSAP unavailable — page renders fully without entrance, reveals still run */
        }
      };

      if (sessionStorage.getItem('hasSeenIntro')) {
        runHeroEntrance();
      } else {
        // Decorative entrance — only fires once the intro reports it's done.
        // If IntroSequence fails to load, the hero is already at its final
        // state (no flicker), the entrance is simply skipped.
        window.addEventListener('ded-intro-done', runHeroEntrance, { once: true });
      }
    }

    // Scroll reveal handled globally by the inline observer in Base.astro
  }
</script>

<script>
  // ── Gallery lightbox ──────────────────────────────────────────────────────
  // Purely additive: thumbnails are normal <img>s wrapped in trigger buttons;
  // if this never runs they still display inline and the overlay stays hidden.
  // Bundled (script-src 'self'); transitions driven by CSS classes, not inline
  // styles. element.style is only used for body scroll-lock (CSSOM, CSP-safe).
  (() => {
    const overlay = document.getElementById('lightbox');
    const triggers = Array.from(document.querySelectorAll('.w-g-trigger'));
    if (!overlay || triggers.length === 0) return;

    const imgEl = overlay.querySelector('.lb-img') as HTMLImageElement;
    const capEl = overlay.querySelector('.lb-cap') as HTMLElement;
    const btnClose = overlay.querySelector('.lb-close') as HTMLButtonElement;
    const btnPrev = overlay.querySelector('.lb-prev') as HTMLButtonElement;
    const btnNext = overlay.querySelector('.lb-next') as HTMLButtonElement;

    // Build the item list from the DOM (single source of truth, gallery order).
    triggers.sort((a, b) =>
      Number((a as HTMLElement).dataset.lbIndex) - Number((b as HTMLElement).dataset.lbIndex));
    const items = triggers.map((t) => {
      const im = t.querySelector('img') as HTMLImageElement;
      return { src: im.getAttribute('src') || '', alt: im.getAttribute('alt') || '',
        cap: (t as HTMLElement).dataset.lbCaption || '' };
    });
    const N = items.length;
    const single = N < 2;
    if (single) { btnPrev.hidden = true; btnNext.hidden = true; }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let lastFocused: HTMLElement | null = null;

    const preload = (i: number) => {
      const it = items[((i % N) + N) % N];
      if (it) { const im = new Image(); im.src = it.src; }
    };
    const apply = (i: number) => {
      current = ((i % N) + N) % N;
      const it = items[current];
      imgEl.src = it.src;
      imgEl.alt = it.alt;
      capEl.textContent = it.cap;
      if (!single) { preload(current + 1); preload(current - 1); }
    };

    const navigate = (dir: number) => {
      if (single) return;
      if (reduced) { apply(current + dir); return; }
      const out = dir > 0 ? 'lb-out-next' : 'lb-out-prev';
      const enter = dir > 0 ? 'lb-enter-next' : 'lb-enter-prev';
      imgEl.classList.add(out);
      window.setTimeout(() => {
        apply(current + dir);
        imgEl.classList.remove(out);
        imgEl.classList.add('lb-noanim', enter);
        void imgEl.offsetWidth;                       // commit entry position
        imgEl.classList.remove('lb-noanim', enter);   // animate to rest
      }, 280);
    };

    // DOM/tab order is [close, prev, next] — query so first/last match it.
    const focusables = () =>
      Array.from(overlay.querySelectorAll('button')).filter((b) => !(b as HTMLButtonElement).hidden) as HTMLButtonElement[];
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'ArrowLeft') { e.preventDefault(); navigate(-1); return; }
      if (e.key === 'ArrowRight') { e.preventDefault(); navigate(1); return; }
      if (e.key === 'Tab') {
        const f = focusables();
        if (f.length === 0) { e.preventDefault(); return; }
        const first = f[0], last = f[f.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !overlay.contains(active))) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && (active === last || !overlay.contains(active))) { e.preventDefault(); first.focus(); }
      }
    };

    const open = (index: number, trigger: HTMLElement) => {
      lastFocused = trigger || (document.activeElement as HTMLElement);
      apply(index);
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      void overlay.offsetWidth;            // commit hidden→shown before fading in
      overlay.classList.add('is-open');
      document.addEventListener('keydown', onKeydown, true);
      btnClose.focus();
    };
    const close = () => {
      overlay.classList.remove('is-open');
      document.removeEventListener('keydown', onKeydown, true);
      document.body.style.overflow = '';
      const finish = () => { overlay.hidden = true; };
      if (reduced) finish(); else window.setTimeout(finish, 200);
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    };

    triggers.forEach((t, i) => {
      t.addEventListener('click', (e) => { e.preventDefault(); open(i, t as HTMLElement); });
    });
    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', () => navigate(-1));
    btnNext.addEventListener('click', () => navigate(1));
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

    // Touch swipe (horizontal)
    let tx = 0, ty = 0, touching = false;
    overlay.addEventListener('touchstart', (e) => {
      if (e.touches.length !== 1) return;
      touching = true; tx = e.touches[0].clientX; ty = e.touches[0].clientY;
    }, { passive: true });
    overlay.addEventListener('touchend', (e) => {
      if (!touching) return; touching = false;
      const dx = e.changedTouches[0].clientX - tx;
      const dy = e.changedTouches[0].clientY - ty;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) navigate(dx < 0 ? 1 : -1);
    }, { passive: true });
  })();
</script>
