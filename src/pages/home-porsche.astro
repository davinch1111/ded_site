</style>

<script>
  // ── Nav: flip to light when scrolling over white sections ──
  const hpNav = document.getElementById('hp-nav');
  const lightSections = document.querySelectorAll('.work-header, .services-section, .contact-section');

  if (hpNav && lightSections.length) {
    const lightSet = new Set();
    const navObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) lightSet.add(e.target);
        else lightSet.delete(e.target);
        hpNav.classList.toggle('nav--light', lightSet.size > 0);
      });
    }, { rootMargin: '-60px 0px -80% 0px', threshold: 0 });
    lightSections.forEach(s => navObs.observe(s));
  }

  // ── Scroll-driven dark body background:
  //    activate after the first row has scrolled past viewport mid,
  //    deactivate as the services section rises into view.
  const firstRow = document.querySelector('.work-row');
  const services = document.querySelector('.services-section');
  let ticking = false;
  function updateDarkZone() {
    if (!firstRow || !services) return;
    const firstRowBottom = firstRow.getBoundingClientRect().bottom;
    const servicesTop    = services.getBoundingClientRect().top;
    const vh = window.innerHeight;
    if (firstRowBottom < vh * 0.5 && servicesTop > vh * 0.3) {
      document.body.classList.add('dark-zone-active');
    } else {
      document.body.classList.remove('dark-zone-active');
    }
  }
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { updateDarkZone(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });
  updateDarkZone();

  // ── Chip toggles ──
  document.querySelectorAll('[data-chip]').forEach(c => {
    c.addEventListener('click', () => c.classList.toggle('on'));
  });

  // ── :has() fallback for older browsers (per-row) ──
  const supportsHas = CSS.supports('selector(:has(div))');
  if (!supportsHas) {
    document.querySelectorAll('.work-row').forEach(row => {
      const cards = Array.from(row.querySelectorAll('.card'));
      cards.forEach((card, i) => {
        card.addEventListener('mouseenter', () => {
          row.classList.remove('expand-left', 'expand-right');
          row.classList.add(i === 0 ? 'expand-left' : 'expand-right');
        });
        card.addEventListener('mouseleave', () => {
          row.classList.remove('expand-left', 'expand-right');
        });
      });
    });
  }

  // ── Scroll reveal ──
  const reveals = document.querySelectorAll('.reveal');
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
  }, { threshold: 0.15 });
  reveals.forEach(el => revealObs.observe(el));
</script>
