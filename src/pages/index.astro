      video.addEventListener('progress', maybeReveal);
      video.addEventListener('timeupdate', maybeReveal);
      video.addEventListener('canplaythrough', maybeReveal);
      // Fallback: if it is genuinely playing with a full readyState but the
      // buffered-ahead math never trips (MSE edge cases), reveal anyway so the
      // hero is never stuck on the static poster while video plays beneath it.
      video.addEventListener('playing', () => {
        if (video.readyState >= HAVE_ENOUGH_DATA) reveal();
      });

      // Seamless loop. Native `loop` can stall under MSE, so also handle 'ended'
      // explicitly: seek back to the first frame and replay. Both set for safety.
      video.loop = true;
      video.addEventListener('ended', () => {
        video.currentTime = 0;
        video.play().catch(() => {});
      });

      const tryPlay = () => { video.play().catch(() => {}); };

      // Prefer hls.js wherever MSE is available (Chromium / Firefox), so we can
      // lock the rendition. Fall back to native HLS only when hls.js can't run
      // — i.e. real Safari/iOS, where Hls.isSupported() is false. (Chromium's
      // canPlayType for HLS can return a misleading "maybe", so it must NOT be
      // the primary branch.)
      if (Hls.isSupported()) {
        // enableWorker:false avoids the blob: worker that strict CSP would block.
        // backBufferLength:Infinity keeps the start segment resident so the loop
        // can wrap to 0 with no re-fetch stall / black frame.
        const hls = new Hls({ enableWorker: false, startLevel: -1, backBufferLength: Infinity });
        hls.loadSource(src);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, (_evt, data) => {
          // Lock to a single ~720p rendition so ABR never ramps up from the
          // tiny bottom level (the pixelated start). Pick 720p exactly, else
          // the closest at-or-below, else the highest — never the tiny one.
          const levels = data.levels || [];
          let idx = levels.findIndex((l) => l.height === 720);
          if (idx < 0) {
            let best = -1;
            levels.forEach((l, i) => {
              const h = l.height || 0;
              if (h <= 720 && h > best) { best = h; idx = i; }
            });
          }
          if (idx < 0) idx = levels.length - 1;
          hls.startLevel = idx;        // initial load level
          hls.autoLevelCapping = idx;  // never climb above ~720p
          hls.currentLevel = idx;      // force it now → no climb from the bottom
          tryPlay();
        });
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        // Safari / iOS — native HLS, no hls.js. Safari picks a sane rendition
        // itself; the buffer-gate above still defers the reveal until clean.
        video.src = src;
        video.addEventListener('loadedmetadata', tryPlay, { once: true });
        tryPlay();
      }
      // Neither path → dark hero stays (fail-safe, no error surfaced).
    }
  }

  // ── Hero rise-in: triggered when the intro overlay finishes wiping.
  //    IntroSequence dispatches 'ded-intro-done' on wipe-complete or, on
  //    repeat-visit (sessionStorage already set), immediately on mount.
  //    Fallback timer fires the same trigger if the event never lands.
  (() => {
    const hero = document.querySelector('.hp-hero');
    if (!hero) return;
    // FAIL-SAFE gate: only now that this script is confirmed running may the
    // hero title be hidden for its entrance animation (html.js-hero enables
    // the opacity:0 pre-state in CSS). Script blocked => title stays visible.
    document.documentElement.classList.add('js-hero');
    const reveal = () => hero.classList.add('intro-done');
    if (sessionStorage.getItem('hasSeenIntro')) {
      reveal();
    } else {
      window.addEventListener('ded-intro-done', reveal, { once: true });
      // Safety net: if intro never reports back, reveal anyway after the
      // intro's max runtime (3.5s hold + 0.8s wipe + 1s slack ≈ 5.3s).
      setTimeout(reveal, 5500);
    }
  })();

  // Nav light/dark flip lives in src/components/SiteNav.astro

  // ── Scroll-driven dark body background:
  //    activate once the user is ~a quarter of the way into the SECOND
  //    row of cards, deactivate as the services section rises into view.
  //    Sentinel moved up from row 1 to row 2 — fires when row 2's top
  //    crosses half of the viewport height, which lands ~1/4 of the way
  //    through the user's visit-scroll across row 2 (it begins entering
  //    at top = vh, exits at top = 0; firing at vh*0.5 means we've
  //    scrolled ~30% of the time row 2 is on screen).
  const services = document.querySelector('.services-section');
  let ticking = false;
  function updateDarkZone() {
    // Rows are re-queried each tick: with showcase paging the visible rows
    // belong to whichever .work-page is active. Single-row pages fall back
    // to their first row so the tint still releases correctly.
    const rows = document.querySelectorAll('.work-page.is-active .work-row');
    const secondRow = (rows[1] ?? rows[0]) as HTMLElement | undefined;
    if (!secondRow || !services) return;
    const secondRowTop = secondRow.getBoundingClientRect().top;
    const servicesTop  = services.getBoundingClientRect().top;
    const vh = window.innerHeight;
    if (secondRowTop < vh * 0.5 && servicesTop > vh * 0.3) {
      document.body.classList.add('dark-zone-active');
    } else {
      document.body.classList.remove('dark-zone-active');
    }
  }
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { updateDarkZone(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });
  updateDarkZone();

  // ── Chip toggles ──
  document.querySelectorAll('[data-chip]').forEach(c => {
    c.addEventListener('click', () => c.classList.toggle('on'));
  });

  // ── Showcase paging: arrows step through sets of six projects ──
  const showcasePagesEls = Array.from(document.querySelectorAll('.work-page'));
  const navPrev = document.querySelector('.work-nav--prev') as HTMLButtonElement | null;
  const navNext = document.querySelector('.work-nav--next') as HTMLButtonElement | null;
  const pageStatus = document.getElementById('work-page-status');
  if (showcasePagesEls.length > 1 && navPrev && navNext) {
    // FAIL-SAFE gate: inactive pages only hide once this script is
    // confirmed running. No JS => all pages stay visible, stacked.
    document.documentElement.classList.add('js-showcase');
    let current = 0;
    const renderPage = () => {
      showcasePagesEls.forEach((p, i) => p.classList.toggle('is-active', i === current));
      navPrev.disabled = current === 0;
      navNext.disabled = current === showcasePagesEls.length - 1;
      if (pageStatus) pageStatus.textContent =
        `Showing projects ${current + 1} of ${showcasePagesEls.length}`;
      updateDarkZone(); // grid height changed — re-evaluate the tint
    };
    navPrev.addEventListener('click', () => { if (current > 0) { current -= 1; renderPage(); } });
    navNext.addEventListener('click', () => { if (current < showcasePagesEls.length - 1) { current += 1; renderPage(); } });
    renderPage();
  }

  // ── :has() fallback for older browsers (per-row) ──
  const supportsHas = CSS.supports('selector(:has(div))');
  if (!supportsHas) {
    document.querySelectorAll('.work-row').forEach(row => {
      const cards = Array.from(row.querySelectorAll('.card'));
      cards.forEach((card, i) => {
        card.addEventListener('mouseenter', () => {
          row.classList.remove('expand-left', 'expand-right');
          row.classList.add(i === 0 ? 'expand-left' : 'expand-right');
        });
        card.addEventListener('mouseleave', () => {
          row.classList.remove('expand-left', 'expand-right');
        });
      });
    });
  }

  // ── Porsche-style hover video on work cards ──
  //   The poster (master image) is always shown at rest. The video has no src
  //   and preload="none", so nothing loads on page load; on first hover we set
  //   the src (one fetch), then play. On leave we pause and reset to the start.
  //   GUARDS: only on devices that actually hover with a fine pointer, and
  //   never under reduced-motion — both fall back to the static poster.
  {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canHover && !reduceMotion) {
      document.querySelectorAll('.card-video').forEach((el) => {
        const video = el as HTMLVideoElement;
        const card = video.closest('.card');
        const src = video.dataset.hoverSrc;
        if (!card || !src) return;
        let loaded = false;
        card.addEventListener('mouseenter', () => {
          if (!loaded) { video.src = src; loaded = true; }  // fetch on first hover only
          video.play().catch(() => {});
        });
        card.addEventListener('mouseleave', () => {
          video.pause();
          video.currentTime = 0;  // back to the first frame (poster)
        });
      });
    }
  }

  // ── Showreel modal ────────────────────────────────────────────────────────
  //   Progressive enhancement: the hero "Showreel" link is a real anchor to the
  //   Stream watch page. This intercepts a plain left-click and opens a centered
  //   modal with the Stream iframe player (native controls/scrub/fullscreen).
  //   Modifier/middle clicks fall through to the anchor (new tab). On close the
  //   iframe is removed from the DOM so playback + audio stop immediately.
  //   Mirrors the work-page lightbox: scrim/Esc/X close, focus trap, scroll-lock.
  (() => {
    const modal = document.getElementById('showreel-modal');
    const triggers = Array.from(document.querySelectorAll('[data-showreel]'));
    if (!modal || triggers.length === 0) return;

    const btnClose = modal.querySelector('.sr-close') as HTMLButtonElement | null;
    const frameWrap = modal.querySelector('.sr-frame-wrap') as HTMLElement | null;
    if (!btnClose || !frameWrap) return;

    const IFRAME_SRC =
      'https://customer-svfce6is3mlvvekf.cloudflarestream.com/bde8b56a0110fbecaeba46a28d485527/iframe?autoplay=true';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lastFocused: HTMLElement | null = null;

    // Focusables in DOM order: the close button plus the player iframe once injected.
    const focusables = () =>
      Array.from(modal.querySelectorAll('button, iframe'))
        .filter((el) => !(el as HTMLElement).hidden) as HTMLElement[];

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'Tab') {
        const f = focusables();
        if (f.length === 0) { e.preventDefault(); return; }
        const first = f[0], last = f[f.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !modal.contains(active))) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && (active === last || !modal.contains(active))) { e.preventDefault(); first.focus(); }
      }
    };

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      // Inject the iframe only on open — nothing from Stream loads on page load.
      const iframe = document.createElement('iframe');
      iframe.src = IFRAME_SRC;
      iframe.title = 'David Ediger showreel';
      iframe.allow = 'accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;';
      iframe.allowFullscreen = true;
      frameWrap.appendChild(iframe);

      modal.hidden = false;
      document.body.style.overflow = 'hidden';   // scroll-lock (CSSOM, CSP-safe)
      void modal.offsetWidth;                     // commit hidden→shown before fading
      modal.classList.add('is-open');
      document.addEventListener('keydown', onKeydown, true);
      btnClose.focus();
    };

    const close = () => {
      modal.classList.remove('is-open');
      document.removeEventListener('keydown', onKeydown, true);
      document.body.style.overflow = '';
      frameWrap.replaceChildren();                // tear down iframe → stops audio now
      const finish = () => { modal.hidden = true; };
      if (reduced) finish(); else window.setTimeout(finish, 200);
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    };

    triggers.forEach((t) => {
      t.addEventListener('click', (e) => {
        const me = e as MouseEvent;
        // Let modified / non-primary clicks use the real href (open in new tab).
        if (me.defaultPrevented || me.button !== 0 ||
            me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
        e.preventDefault();
        open();
      });
    });
    btnClose.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  })();

  // Scroll reveal handled globally by the inline observer in Base.astro
</script>
