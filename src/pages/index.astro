---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import ScrollCue from '../components/ScrollCue.astro';
import ServicesSection from '../components/ServicesSection.astro';

interface Project {
  id: number;
  slug: string;
  title: string;
  disciplines: string;
  image: string | null;       // ACF master_image, falling back to the featured image
  hoverVideo: string | null;  // ACF hover_video (R2 MP4); null = static-image card
}

// Tiles without imagery get a brand-tone gradient via .card-tone-{i % 6}
// classes (defined in the CSS below) — keyed off grid position, not stored
// per project. Classes instead of inline style="" keep the CSP free of
// style-src 'unsafe-inline'.
const FALLBACK_PROJECTS: Project[] = [
  { id: 1, slug: 'innotech-windows-and-doors', title: 'Innotech Windows & Doors', disciplines: 'Print · Video · Wraps · Since 2008', image: null, hoverVideo: null },
  { id: 2, slug: 'chanvre-hemp',               title: 'Chanvre Hemp',             disciplines: 'Brand · Packaging · Video',          image: null, hoverVideo: null },
  { id: 3, slug: 'first-light-fishing',        title: 'First Light Fishing',      disciplines: 'Brand · Web · Photography',          image: null, hoverVideo: null },
  { id: 4, slug: 'rackon',                     title: 'RackOn',                   disciplines: 'Video · Brand · Mascot',             image: null, hoverVideo: null },
  { id: 5, slug: 'wayne-northey',              title: 'Wayne Northey',            disciplines: 'Web · Identity',                     image: null, hoverVideo: null },
  { id: 6, slug: 'vindauga-windows',           title: 'Vindauga Windows',         disciplines: 'Web · Brand',                        image: null, hoverVideo: null },
];

let projects: Project[] = FALLBACK_PROJECTS;

const WP_API = 'https://davidedigerdesign.in/wp-json/wp/v2';
const isAttachmentId = (v: any): v is number =>
  typeof v === 'number' && Number.isFinite(v) && v > 0;

try {
  // orderby=menu_order: the drag-and-drop order set in WP (ASE Content Order).
  const res = await fetch(
    `${WP_API}/ded_project?per_page=24&orderby=menu_order&order=asc&_embed`,
    { signal: AbortSignal.timeout(8000) }
  );
  if (res.ok) {
    const data = await res.json() as any[];

    // Resolve ACF master_image → URL. It's either an image object
    // (return_format=array) or a bare attachment ID (legacy); batch-resolve
    // the IDs via the media endpoint, mirroring work/[slug].astro.
    const masterIds = new Set<number>();
    for (const p of data) if (isAttachmentId(p?.acf?.master_image)) masterIds.add(p.acf.master_image);
    const mediaUrl = new Map<number, string>();
    if (masterIds.size > 0) {
      try {
        const r = await fetch(
          `${WP_API}/media?include=${Array.from(masterIds).join(',')}&per_page=100&_fields=id,source_url`,
          { signal: AbortSignal.timeout(8000) }
        );
        if (r.ok) for (const m of await r.json() as any[]) mediaUrl.set(m.id, m.source_url);
      } catch { /* leave unresolved → featured-image fallback below */ }
    }

    const mapped: Project[] = data.map((p: any) => {
      const termGroups: any[][] = p._embedded?.['wp:term'] ?? [];
      const disciplines = termGroups.flat()
        .filter((t: any) => t.taxonomy === 'discipline')
        .map((t: any) => t.name as string)
        .join(' · ');
      const mi = p?.acf?.master_image;
      const masterUrl: string | null =
        (mi && typeof mi === 'object' && mi.url) ? mi.url
        : isAttachmentId(mi) ? (mediaUrl.get(mi) ?? null)
        : null;
      const featuredUrl: string | null =
        (p._embedded?.['wp:featuredmedia'] ?? [])[0]?.source_url ?? null;
      const hv = p?.acf?.hover_video;
      const hoverVideo: string | null =
        (typeof hv === 'string' && hv.trim()) ? hv.trim() : null;
      return {
        id: p.id as number,
        slug: (p.slug ?? '') as string,
        title: (p.title?.rendered ?? 'Untitled') as string,
        disciplines: disciplines || 'Design · 2026',
        image: masterUrl ?? featuredUrl,   // master_image preferred, featured fallback
        hoverVideo,
      };
    });
    if (mapped.length > 0) {
      // ALL published projects show — image-less ones get the branded
      // placeholder treatment (brand-tone gradient + ghosted emblem, see
      // .card-tone-* / .card-ghost) and switch to imagery automatically
      // once a master image lands in WP.
      projects = mapped.length >= 6
        ? mapped
        : [...mapped, ...FALLBACK_PROJECTS.slice(mapped.length)];
    }
  }
} catch { /* WP unreachable — use fallback */ }

// Showcase paging: sets of 6 (3 rows × 2). The prev/next arrows only render
// when there is more than one page.
const PAGE_SIZE = 6;
const showcasePages: Project[][] = [];
for (let i = 0; i < projects.length; i += PAGE_SIZE) {
  showcasePages.push(projects.slice(i, i + PAGE_SIZE));
}

// About — industry experience rows (editorial, mirrors the Services rows).
// Client names only where the portfolio actually evidences them.
const industries = [
  { name: 'Manufacturing & Fenestration', note: 'Print, video, wraps, and tradeshow for window and door makers. Innotech since 2008; Vindauga.', tag: 'since 2008' },
  { name: 'Multifamily Development & Real Estate', note: 'Marketing for developments that have to sell before they’re built.' },
  { name: 'Health Care', note: 'Clear, human communication in a field that rarely gets either.' },
  { name: 'Legal & Accounting', note: 'Credibility on paper and on screen for professional practices.' },
  { name: 'Cosmetics & Fashion', note: 'Image-led brand and campaign work, where the look is the product.' },
  { name: 'Food, Beverage & CPG', note: 'Brand to shelf: identity, packaging, photography. Chanvre Hemp; Pet Goodies.' },
  { name: 'Outdoor & Recreation', note: 'Brands built for people who’d rather be outside. First Light Fishing; RackOn.' },
  { name: 'Construction & Trades', note: 'Straight-talking brands for people who build things. Ediger Phoenix Sundecks.' },
  { name: 'Nonprofit & Community', note: 'Storytelling that moves people to give. El Salvador home-building.' },
];

// Industry rows use the Studio-services grid: `slot` is the item's position
// in the numbered sequence regardless of which column it renders in, so the
// slot class can drive the accent-rule width and the mobile stacking order
// from CSS instead of an inline style (strict CSP forbids style attributes).
const industryItems = industries.map((ind, i) => ({ ...ind, slot: i + 1 }));
const indLeft  = industryItems.filter((_, i) => i % 2 === 0);
const indRight = industryItems.filter((_, i) => i % 2 === 1);
const indSlot = (slot: number) => `arow--${String(slot).padStart(2, '0')}`;

const quotes = [
  { text: 'We have worked with David since 2008. He is dependable, professional and highly talented. He has helped us successfully brand our company.',
    name: 'Jessica Owen', role: 'Marketing Manager, Innotech' },
  { text: "David has to be one of the most talented graphic designers I have ever seen. I've hired hundreds of designers. His talent is head and shoulders above the rest.",
    name: 'Kim Mullin', role: 'Business Development' },
  { text: 'David Ediger Design is my first and only recommendation to professional business owners. His passion for design and branding is exceptional and consistent.',
    name: 'Dave Fullerton', role: 'Investment Manager' },
];

// ─── SEO ─────────────────────────────────────────────────────────────────────
const siteName = 'David Ediger Design';
const homeTitle = 'David Ediger Design — Portfolio';
const homeDesc =
  'Twenty-three years of print, web, video, photo, and audio. Brands that refuse to blend in.';
const canonical = new URL('/', Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const personId = new URL('/#david-ediger', Astro.site).href;
const orgId = new URL('/#organization', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      'name': 'David Ediger',
      'jobTitle': 'Creative Director',
      'url': canonical,
      'worksFor': { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      'name': siteName,
      'url': canonical,
      'logo': new URL('/images/ded-logo-2026-colour.svg', Astro.site).href,
      'email': 'info@davidedigerdesign.com',
      'founder': { '@id': personId },
      'sameAs': [
        'https://www.instagram.com/david.ediger.design',
        'https://www.linkedin.com/in/david-ediger-b402a914/',
        'https://vimeo.com/davidediger/',
        'https://www.youtube.com/channel/UCVzIVyhZouAq7VjKLsuCPyQ',
      ],
    },
  ],
};
---

<Base title={homeTitle} description={homeDesc}>

  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={homeTitle} />
    <meta property="og:description" content={homeDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Ediger Design — Brands that refuse to blend in" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={homeTitle} />
    <meta name="twitter:description" content={homeDesc} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

<div class="hp">

  <SiteNav />

  <main id="main">

  <!-- ══════════════ HERO ══════════════ -->
  <section class="hp-hero">
    <!-- Background video (additive). The dark .hp-hero base + headline render
         on their own; the video fades in over the base only once it is actually
         playing. No src in markup — hls.js (or Safari native HLS) supplies it,
         and only when motion is allowed and the viewport is wide enough. -->
    <video
      class="hero-video"
      muted
      loop
      playsinline
      autoplay
      preload="auto"
      aria-hidden="true"
      data-hls-src="https://customer-svfce6is3mlvvekf.cloudflarestream.com/bde8b56a0110fbecaeba46a28d485527/manifest/video.m3u8"
    ></video>
    <div class="hero-video-scrim" aria-hidden="true"></div>
    <img src="/images/ded_emblem_white.svg" class="hero-emblem" alt="" aria-hidden="true" />
    <div class="hero-text">
      <p class="hero-ey">DAVID EDIGER DESIGN&nbsp;&nbsp;|&nbsp;&nbsp;CREATED FOR YOU IN: PRINT. WEB. VIDEO. PHOTO. AUDIO.</p>
      <h1 class="hero-h1">Brands that<br><strong>refuse</strong> to blend in</h1>
      <p class="hero-sub">Twenty-three years of print, web, video, photo, and audio. Some of these clients have stayed since 2008.</p>
      <!-- Real anchor to the Stream watch page (progressive enhancement): with
           JS it opens the centered modal player; with JS blocked it opens the
           reel in a new tab. Never a dead control. -->
      <a
        class="hero-showreel"
        href="https://customer-svfce6is3mlvvekf.cloudflarestream.com/bde8b56a0110fbecaeba46a28d485527/watch"
        target="_blank"
        rel="noopener"
        data-showreel
      >
        <Icon name="play" />Watch showreel
      </a>
    </div>
    <ScrollCue href="#work" />
  </section>

  <!-- ══════════════ WORK — dark-zone wrapper ══════════════ -->
  <div class="dark-zone" id="work">

    <!-- Part A — header (transparent over body) -->
    <section class="work-header">
      <div class="work-header-inner">
        <p class="work-label work-eyebrow">Selected work</p>
        <h2 class="work-heading reveal">Twenty-three years of making<br>things worth looking at</h2>
        <p class="work-subhead reveal">A selection of recent work across identity, packaging, web, video, and print. Each one built to do a specific job for a specific audience.</p>
      </div>
    </section>

    <!-- Part B — card grid (transparent over body) -->
    <section class="work-grid-wrap">
      <div class="work-grid-inner">
        {showcasePages.length > 1 && (
          <button class="work-nav work-nav--prev" type="button" aria-controls="work-grid" aria-label="Previous projects" disabled>
            <Icon name="chevron-left" />
          </button>
        )}
        <div class="work-rows" id="work-grid">
          {showcasePages.map((group, pi) => (
            <div class:list={['work-page', { 'is-active': pi === 0 }]} data-page={pi}>
              {[0, 2, 4].map(start => group.length > start && (
                <div class="work-row">
                  {group.slice(start, start + 2).map((p, j) => {
                    const i = pi * PAGE_SIZE + start + j;
                    const href = p.slug ? `/work/${p.slug}/` : '#work';
                    const cleanTitle = p.title.replace(/<[^>]+>/g, '');
                    return (
                      <a
                        class:list={['card', 'reveal', !p.image && `card-tone-${i % 6}`]}
                        href={href}
                        data-idx={i}
                        aria-label={`View project: ${cleanTitle}`}
                      >
                        {/* Single scaled media wrapper: the hover-zoom transform
                            lives here (a non-video element), so the poster and the
                            playing <video> scale together as one unit and a
                            composited playing video can't escape the frame. */}
                        <div class="card-media">
                          {p.hoverVideo ? (
                            /* Static poster (master image) always present, so first
                               paint matches a static card. Video has no src + preload
                               none — the JS fetches + plays it only on first hover. */
                            <video
                              class="card-video"
                              muted
                              loop
                              playsinline
                              preload="none"
                              poster={p.image || undefined}
                              data-hover-src={p.hoverVideo}
                              aria-hidden="true"
                            ></video>
                          ) : p.image ? (
                            <img src={p.image} alt={cleanTitle} loading={i < 2 ? 'eager' : 'lazy'} />
                          ) : (
                            /* Awaiting imagery: ghosted emblem on the tone tile */
                            <img class="card-ghost" src="/images/ded_emblem_white.svg" alt="" aria-hidden="true" loading="lazy" />
                          )}
                        </div>
                        <div class="card-top-scrim"></div>
                        <div class="card-title" set:html={p.title} />
                        <div class="card-info">
                          <span class="card-desc">{p.disciplines}</span>
                          <div class="card-cta-area">
                            <span class="card-arrow" aria-hidden="true">
                              <Icon name="arrow-right" />
                            </span>
                            <span class="card-cta" aria-hidden="true">
                              View project <Icon name="arrow-right" />
                            </span>
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              ))}
            </div>
          ))}
        </div>
        {showcasePages.length > 1 && (
          <button class="work-nav work-nav--next" type="button" aria-controls="work-grid" aria-label="Next projects">
            <Icon name="chevron-right" />
          </button>
        )}
        {showcasePages.length > 1 && (
          <span class="vh" id="work-page-status" aria-live="polite"></span>
        )}
      </div>
    </section>

  </div><!-- /.dark-zone -->

  <!-- ══════════════ SERVICES ══════════════
       Renders <section class="svc" id="services"> — a light band, so it is in
       SiteNav's light-flip observer list and is the dark-zone release
       sentinel below. Both hooks select `.svc`. -->
  <ServicesSection />

  <!-- ══════════════ ABOUT ══════════════ -->
  <section class="about-section" id="about">
    <div class="about-inner">
      <p class="a-label">About the studio</p>
      <h2 class="a-heading reveal">One desk. Every discipline.<br>Twenty-three years deep.</h2>

      <div class="about-cols">
        <div class="about-story reveal">
          <p class="a-lede">David Ediger Design is the studio of David Ediger — a creative director who has spent twenty-three years making brands impossible to ignore.</p>
          <p>Print, web, video, photo, and audio under one roof means the person who designs your identity is the same one who shoots the video and builds the site. Nothing gets lost between departments, because there aren't any.</p>
          <p>That range was earned inside very different industries — and the proof is simple: clients who arrived in 2008 are still here.</p>
        </div>
        <div class="about-facts reveal">
          <div class="a-fact">
            <span class="a-fact-num">23</span>
            <span class="a-fact-lab">Years in practice</span>
          </div>
          <div class="a-fact">
            <span class="a-fact-num">2008</span>
            <span class="a-fact-lab">Longest client relationship</span>
          </div>
          <div class="a-fact">
            <span class="a-fact-num">5</span>
            <span class="a-fact-lab">Disciplines, one desk</span>
          </div>
        </div>
      </div>

      <div class="about-industries">
        <p class="a-label a-label--sub">Industry experience</p>
        {/* Same grid format as Studio services: two columns, right column
            dropped by --shell-offset, collapsing to one column in slot
            order below 860px. */}
        <div class="agrid">
          <div class="acol acol--left">
            {indLeft.map(ind => (
              <div class:list={['arow', 'reveal', indSlot(ind.slot)]}>
                <span class="arule" aria-hidden="true"></span>
                <div class="aname">{ind.name}</div>
                <p class="anote">{ind.note}</p>
                {ind.tag && <span class="atag">{ind.tag}</span>}
              </div>
            ))}
          </div>
          <div class="acol acol--right">
            {indRight.map(ind => (
              <div class:list={['arow', 'reveal', indSlot(ind.slot)]}>
                <span class="arule" aria-hidden="true"></span>
                <div class="aname">{ind.name}</div>
                <p class="anote">{ind.note}</p>
                {ind.tag && <span class="atag">{ind.tag}</span>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ TESTIMONIALS ══════════════ -->
  <section class="quotes-section">
    <div class="quotes-inner">
      <p class="q-label">What people say</p>
      <h2 class="q-heading">Twenty years of working relationships</h2>
      <div class="qgrid">
        {quotes.map(q => (
          <div class="qcard reveal">
            <div class="qmark">"</div>
            <p class="qtext">{q.text}</p>
            <div class="qname">{q.name}</div>
            <div class="qrole">{q.role}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════ CONTACT ══════════════ -->
  <section class="contact-section" id="contact">
    <div class="contact-inner">
      <p class="c-label">Start a project</p>
      <h2 class="c-heading reveal">Tell me what you're building</h2>
      <p class="c-sub">I take on a small number of new projects each year. A few quick questions and I'll know if I'm the right fit.</p>
      {/* Web3Forms endpoint — the access key is public-by-design (it can only
          deliver mail TO the studio inbox). FAIL-SAFE: without JS this is a
          plain POST that lands on Web3Forms' hosted success page; the bundled
          script upgrades it to an on-page inline status. */}
      <form class="c-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="9861cb49-8baf-4327-93b9-8393fe13255a" />
        <input type="hidden" name="subject" value="New project inquiry — davidedigerdesign.com" />
        <input type="hidden" name="from_name" value="DED website contact form" />
        {/* Honeypot — hidden from people, tempting to bots; Web3Forms drops
            any submission where this is checked. */}
        <input type="checkbox" name="botcheck" class="c-hp" tabindex="-1" aria-hidden="true" />

        <div class="c-row">
          <input class="c-inp" type="text"  name="name"  placeholder="Your name" aria-label="Your name" required />
          <input class="c-inp" type="email" name="email" placeholder="Email" aria-label="Email" required />
        </div>
        <input class="c-inp c-inp--company" type="text" name="company" placeholder="Business or company" aria-label="Business or company" />

        <div class="c-flabel" id="chips-label">What can I help with?</div>
        <div class="c-chips" role="group" aria-labelledby="chips-label">
          {['Print','Web','Video','Photo','Audio','Not sure yet'].map(chip => (
            <label class="c-chip">
              <input type="checkbox" name="Interested in" value={chip} />
              {chip}
            </label>
          ))}
        </div>

        <div class="c-row">
          <div>
            <label class="c-flabel" for="c-budget">Budget</label>
            <select class="c-inp" name="budget" id="c-budget">
              <option>Under $5,000</option>
              <option>$5,000 – $15,000</option>
              <option>$15,000 – $40,000</option>
              <option>$40,000+</option>
              <option>Let's talk</option>
            </select>
          </div>
          <div>
            <label class="c-flabel" for="c-timeline">Timeline</label>
            <select class="c-inp" name="timeline" id="c-timeline">
              <option>As soon as possible</option>
              <option>1 – 3 months</option>
              <option>3 – 6 months</option>
              <option>Flexible</option>
            </select>
          </div>
        </div>

        <textarea class="c-inp c-inp--desc" name="description" rows="4"
          placeholder="Tell me about the project. What does success look like?"></textarea>

        <button class="c-submit" type="submit">
          Send it over <Icon name="arrow-right" />
        </button>

        {/* Inline submit status (JS path only) — announced to screen readers */}
        <p class="c-status" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>

  </main>

  <SiteFooter />

  {/* Showreel modal — additive; hidden until the hero "Showreel" link is
      clicked. Placed at page top level (NOT inside a transformed .reveal
      ancestor) so position:fixed resolves to the viewport. The script injects
      the Cloudflare Stream iframe on open and removes it on close (stops audio).
      If the script never runs it stays hidden and the link is a normal anchor
      to the Stream watch page. */}
  <div class="sr-modal" id="showreel-modal" role="dialog" aria-modal="true" aria-label="David Ediger showreel" hidden>
    <button class="sr-close" type="button" aria-label="Close showreel">
      <Icon name="xmark" />
    </button>
    <div class="sr-frame-wrap"><!-- Stream iframe injected here on open --></div>
  </div>

</div><!-- /.hp -->
</Base>

<!-- ══════════════════════════════════════════════════════════
     ALL CSS — single block, is:global to support :has() selectors
════════════════════════════════════════════════════════════ -->
<style is:global>

/* ── .hp wrapper — design tokens now live in Base.astro :root ── */
.hp {
  font-family: 'Montserrat', -apple-system, system-ui, sans-serif;
}

/* ── Body: starts white, transitions dark when dark-zone active ── */
body {
  background-color: #FAFAFA !important;
  transition: background-color 1800ms cubic-bezier(0.4, 0, 0.2, 1) !important;
}

body.dark-zone-active {
  background-color: #03040E !important;
}

/* Nav rules now live in src/components/SiteNav.astro */

/* ═══ HERO ═══ */
.hp-hero {
  min-height: 100vh;
  min-height: 100svh;
  background: var(--black);
  position: relative;
  overflow: hidden;
}

/* ── Hero background video (additive layer) ──
   Sits above the dark base (var(--black)) but below the scrim + all hero
   content. Starts invisible and fades in only once it is actually playing,
   so a failed/blocked video leaves the dark hero untouched (fail-safe). */
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  opacity: 0;
  transition: opacity 1200ms cubic-bezier(.4, 0, .2, 1);
  pointer-events: none;
}
.hp-hero.video-playing .hero-video { opacity: 1; }

/* Legibility scrim over the video — darkest at the bottom-left where the
   eyebrow / headline / subhead sit. Matches the dark hero base tone. */
.hero-video-scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(to top, rgba(3,4,14,0.88) 0%, rgba(3,4,14,0.30) 48%, rgba(3,4,14,0.55) 100%),
    linear-gradient(to right, rgba(3,4,14,0.55) 0%, rgba(3,4,14,0.10) 55%, transparent 100%);
}

/* Keep all hero content above the video + scrim. */
.hp-hero .scroll-cue { z-index: 2; }

@media (prefers-reduced-motion: reduce) {
  /* No autoplay under reduced motion — the JS never starts it; also make sure
     the layer can never appear even if a stray .video-playing class lands. */
  .hero-video { opacity: 0 !important; }
}

/* ≤480px: skip the video entirely (data saving) — show the dark hero. */
@media (max-width: 480px) {
  .hero-video,
  .hero-video-scrim { display: none; }
}

.hero-showreel {
  margin-top: 22px;
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  text-decoration: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  transition: color 200ms ease;
}

.hero-showreel:hover { color: var(--text-white); }
.hero-showreel:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

.hero-showreel .svg-icon {
  font-size: 11px;
  margin-right: 8px;
}

/* ── Showreel modal (mirrors the work-page .lb lightbox patterns) ── */
.sr-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(16px, 4vw, 56px);
  background: rgba(3, 4, 14, 0.85);
  -webkit-backdrop-filter: blur(2px);
  backdrop-filter: blur(2px);
  opacity: 0;
  transition: opacity 200ms ease;
}
.sr-modal[hidden] { display: none; }
.sr-modal.is-open { opacity: 1; }

.sr-frame-wrap {
  position: relative;
  width: min(1200px, 100%);
  aspect-ratio: 16 / 9;
  max-height: calc(100vh - 96px);
  background: #000;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9);
}
.sr-frame-wrap iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.sr-close {
  position: fixed;
  top: clamp(16px, 3vw, 28px);
  right: clamp(16px, 3vw, 28px);
  z-index: 1;
  width: 48px; height: 48px;
  font-size: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(245, 244, 240, 0.3);
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-white);
  border-radius: 50%;
  cursor: pointer;
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.sr-close:hover {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(245, 244, 240, 0.6);
}
.sr-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

@media (prefers-reduced-motion: reduce) {
  .sr-modal { transition: none; }
}

.hero-text {
  position: absolute;
  /* Lifted above the old 48–80px floor so the subhead clears the
     bottom-anchored scroll cue (see .hp-hero .scroll-cue below). Stays
     left-aligned to the left content margin. */
  bottom: clamp(120px, 6vw + 60px, 164px);
  left: clamp(40px, 5vw, 100px);
  right: clamp(40px, 5vw, 100px);
  max-width: 700px;
  z-index: 2;
}

/* Scroll cue (shared component) on the homepage hero only: pushed toward
   the floor so there's clear space between the lifted subhead and the cue —
   it no longer overlaps "…stayed since 2008." */
.hp-hero .scroll-cue {
  bottom: clamp(18px, 3vh, 32px);
}

/* Section eyebrow — same token as Selected work / Studio services, on the
   dark-band colour because the hero sits over the scrimmed video. */
.hero-ey {
  font-family: var(--body);
  font-size: var(--type-eyebrow-size);
  font-weight: var(--type-eyebrow-weight);
  letter-spacing: var(--type-eyebrow-track);
  text-transform: var(--type-eyebrow-transform);
  color: var(--type-eyebrow-color-on-dark);
  margin-bottom: 18px;
}

/* Override Base.astro's global h1 for this hero */
.hp-hero h1 {
  font-family: 'Montserrat', sans-serif !important;
  font-size: clamp(2.4rem, 5vw + 0.3rem, 5rem) !important;
  font-weight: 300 !important;
  color: var(--text-white) !important;
  letter-spacing: -0.02em !important;
  line-height: 1.04 !important;
  margin-bottom: 22px;
}

.hp-hero h1 strong {
  /* True 600 (Montserrat 600 is now loaded in Base.astro's font URL). Before
     600 was loaded the browser rounded this request up to 700, which read
     too heavy. Drop to 500 as the fallback if 600 still feels heavy. */
  font-weight: 600;
  /* Same colour as the rest of the headline — emphasis through weight only,
     never colour, so we don't introduce a second accent on the hero. */
  color: inherit;
}

.hero-sub {
  font-family: var(--body);
  font-size: var(--type-body-size);
  font-weight: var(--type-body-weight);
  color: var(--type-body-color-on-dark);
  line-height: var(--type-body-leading);
  max-width: 52ch;
}

/* ── Hero entrance: rise-up after intro wipe completes ──
   FAIL-SAFE: the hero title is CONTENT and must never be invisible because
   a script didn't run. The hidden/pre-animation state is gated on
   `html.js-hero`, added by this page's script the moment it executes —
   same pattern as the js-reveal fail-safe in Base.astro. If the script is
   blocked or fails, .js-hero never lands and the title renders visible. */
html.js-hero .hero-ey,
html.js-hero .hp-hero h1,
html.js-hero .hero-sub,
html.js-hero .hero-showreel {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 600ms cubic-bezier(.4, 0, .2, 1),
              transform 600ms cubic-bezier(.4, 0, .2, 1);
  will-change: opacity, transform;
}
.hp-hero.intro-done .hero-ey        { transition-delay: 0ms;   }
.hp-hero.intro-done .hero-h1        { transition-delay: 120ms; }
.hp-hero.intro-done .hero-sub       { transition-delay: 240ms; }
.hp-hero.intro-done .hero-showreel  { transition-delay: 360ms; }
.hp-hero.intro-done .hero-ey,
.hp-hero.intro-done .hero-h1,
.hp-hero.intro-done .hero-sub,
.hp-hero.intro-done .hero-showreel {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .hero-ey,
  .hp-hero h1,
  .hero-sub,
  .hero-showreel {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}

/* Hero emblem (≥901px). First pass — positions to be fine-tuned from a
   screenshot.
   • Right edge aligns to the same right content margin as the hero text
     (matching clamp), so emblem and copy share the right boundary.
   • Bottom-anchored up into the eyebrow→headline band: lifted off the text
     bottom by ~the subhead height so its top sits near the eyebrow line and
     its base near the end of the headline.
   • Height is tied to the headline scale — the headline grows on a 5vw axis,
     so the two-line block grows ~2× that; the emblem height uses a
     compatible ~10.5vw clamp so it scales in proportion with the type
     instead of ballooning, staying balanced at every width. width follows
     the SVG aspect ratio (≈0.92). */
.hero-emblem {
  position: absolute;
  right: clamp(40px, 5vw, 100px);
  bottom: clamp(186px, 6vw + 138px, 248px);
  height: clamp(140px, 10.5vw + 52px, 215px);
  width: auto;
  opacity: 0.5;
  pointer-events: none;
  user-select: none;
  z-index: 2;
}

/* ═══ DARK ZONE ═══ */
.dark-zone {
  background: transparent;
}

.dark-zone > section {
  background: transparent !important;
}

/* ═══ WORK — Part A: header ═══ */
.work-header {
  padding: 350px var(--shell-pad) 32px;
}

.work-header-inner {
  max-width: var(--shell-max);
  margin: 0 auto;
}

.work-label,
.work-eyebrow {
  font-family: var(--body);
  font-size: var(--type-eyebrow-size);
  font-weight: var(--type-eyebrow-weight);
  letter-spacing: var(--type-eyebrow-track);
  text-transform: var(--type-eyebrow-transform);
  color: var(--type-eyebrow-color);
  margin-bottom: 14px;
  transition: color 1800ms cubic-bezier(0.4, 0, 0.2, 1);
}

.work-heading {
  font-family: var(--body);
  font-size: var(--type-head-size);
  font-weight: var(--type-head-weight);
  color: var(--type-head-color);
  letter-spacing: var(--type-head-track);
  line-height: var(--type-head-leading);
  transition: color 1800ms cubic-bezier(0.4, 0, 0.2, 1);
}

.work-subhead {
  font-family: var(--body);
  font-size: var(--type-body-size);
  font-weight: var(--type-body-weight);
  line-height: var(--type-body-leading);
  max-width: 62ch;
  margin-top: 16px;
  color: var(--type-body-color);
  transition: color 1800ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Fade work-header text colours in sync with body dark transition */
body.dark-zone-active .work-heading { color: var(--type-head-color-on-dark); }
body.dark-zone-active .work-eyebrow,
body.dark-zone-active .work-label   { color: var(--type-eyebrow-color-on-dark); }
body.dark-zone-active .work-subhead { color: var(--type-body-color-on-dark); }

/* ═══ WORK — Part B: dark grid ═══ */
.work-grid-wrap {
  padding: 0 var(--shell-pad) 80px;
}

.work-grid-inner {
  max-width: var(--shell-max);
  margin: 0 auto;
}

/* ── The Grid: 3 independent rows ── */
.work-rows {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
}

.work-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap);
  height: 600px;
  transition: grid-template-columns 550ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Per-row column expansion — only the hovered row changes */
.work-row:has(.card:nth-child(1):hover) { grid-template-columns: 1.4fr 0.6fr; }
.work-row:has(.card:nth-child(2):hover) { grid-template-columns: 0.6fr 1.4fr; }

/* JS :has() fallback (per-row) */
.work-row.expand-left  { grid-template-columns: 1.4fr 0.6fr; }
.work-row.expand-right { grid-template-columns: 0.6fr 1.4fr; }

/* ═══ SHOWCASE PAGING ═══ */
.work-grid-inner { position: relative; }

.work-page {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
}

/* FAIL-SAFE: every page is visible (stacked) by default, so all projects
   are reachable even if scripts never run. Only once the paging script
   confirms it is live (html.js-showcase) do inactive pages hide and the
   arrows appear. */
html.js-showcase .work-page:not(.is-active) { display: none; }

.work-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: none;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 3;
  /* Theme-adaptive: dark-on-light before the body tint, light-on-dark after,
     fading with the same easing as the rest of the dark-zone text. */
  border: 1px solid rgba(15,16,20,0.3);
  background: rgba(15,16,20,0.04);
  color: var(--text-dark);
  transition: color 600ms cubic-bezier(0.4, 0, 0.2, 1),
              border-color 600ms cubic-bezier(0.4, 0, 0.2, 1),
              background 600ms cubic-bezier(0.4, 0, 0.2, 1),
              opacity 200ms cubic-bezier(.25,.1,.25,1);
}
body.dark-zone-active .work-nav {
  border-color: rgba(245,244,240,0.3);
  background: rgba(255,255,255,0.04);
  color: var(--text-white);
}
html.js-showcase .work-nav { display: flex; }
.work-nav .svg-icon { font-size: 13px; }
.work-nav:hover { background: rgba(15,16,20,0.1); }
body.dark-zone-active .work-nav:hover { background: rgba(255,255,255,0.1); border-color: rgba(245,244,240,0.6); }
.work-nav:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.work-nav:disabled { opacity: 0.25; cursor: default; pointer-events: none; }
.work-nav--prev { left: calc(-1 * min(2.5vw + 22px, 72px)); }
.work-nav--next { right: calc(-1 * min(2.5vw + 22px, 72px)); }

/* Visually-hidden live region announcing the active page */
.vh {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.card {
  position: relative;
  display: block;
  overflow: hidden;
  border-radius: 14px;
  background: var(--card-bg);
  cursor: pointer;
  color: inherit;
  text-decoration: none;
  box-shadow: 0 0 0 1px rgba(255,255,255,0.06);
}
.card:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

/* Brand-tone fallback backgrounds for tiles without imagery.
   Classes (not inline style="") so style-src needs no 'unsafe-inline'. */
/* Brand-tone placeholder tiles — dark-theme takes on the locked palette
   (brand blue / slate / periwinkle / midblue / taupe). Distinct enough to
   read as designed "awaiting content" slots, not blank cards. */
.card-tone-0 { background: linear-gradient(160deg,#1B2A5E 0%,#0B1128 100%); }
.card-tone-1 { background: linear-gradient(160deg,#2A323B 0%,#12161B 100%); }
.card-tone-2 { background: linear-gradient(160deg,#333F63 0%,#151B2C 100%); }
.card-tone-3 { background: linear-gradient(160deg,#22335C 0%,#0E1526 100%); }
.card-tone-4 { background: linear-gradient(160deg,#37322A 0%,#181510 100%); }
.card-tone-5 { background: linear-gradient(160deg,#20263B 0%,#0E111C 100%); }

/* Ghosted emblem on placeholder tiles */
.card-media .card-ghost {
  inset: auto;
  right: -5%;
  bottom: -12%;
  width: 52%;
  height: auto;
  object-fit: contain;
  opacity: 0.08;
  pointer-events: none;
}

/* Card media wrapper — holds both the poster image and the hover <video> and
   is the ONLY element the hover-zoom transform is applied to, so poster + video
   scale together as one unit. Being a plain (non-video) element, its transform
   reliably scales the composited playing video child instead of competing with
   the video's own layer (which is what dropped the scale once playback began). */
.card-media {
  position: absolute;
  inset: 0;
  z-index: 0;
  transition: transform 550ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* The media fills the wrapper and carries NO transform of its own. */
.card-media img,
.card-media video {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
}

.card:hover .card-media { transform: scale(1.04); }

/* Top gradient so card-title reads over dark or photo backgrounds */
.card-top-scrim {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 140px;
  background: linear-gradient(to bottom, rgba(3,4,14,0.65) 0%, transparent 100%);
  z-index: 1;
  pointer-events: none;
}

/* Project name — top-centre, Porsche model-name style */
.card-title {
  position: absolute;
  top: 0; left: 0; right: 0;
  padding: 24px;
  text-align: center;
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(1.1rem, 2vw, 1.6rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  color: var(--text-white);
  text-shadow: 0 1px 8px rgba(0,0,0,0.6);
  z-index: 2;
}

/* Dark info strip — bottom of card */
.card-info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(10,10,15,0.88);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 2;
}

/* Discipline line, e.g. "Print · Video · Wraps". Body size and semi-bold so
   it reads as a real label rather than fine print. */
.card-desc {
  font-family: var(--body);
  font-size: var(--type-body-size);
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-white);
  flex: 1;
  margin-right: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* CTA area — circle arrow fades to text button on hover */
.card-cta-area {
  position: relative;
  width: 36px;
  height: 36px;
  flex-shrink: 0;
}

.card-arrow {
  position: absolute;
  top: 0; right: 0;
  width: 36px; height: 36px;
  border: 1px solid rgba(245,244,240,0.4);
  border-radius: 50%;
  background: none;
  color: var(--text-white);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 1;
  transition: opacity 250ms cubic-bezier(.25,.1,.25,1);
}

.card-arrow .svg-icon { font-size: 11px; }

.card-cta {
  position: absolute;
  top: 50%; right: 0;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'Montserrat', sans-serif;
  font-size: 12px;
  font-weight: 400;
  color: var(--text-white);
  border: 1px solid rgba(245,244,240,0.3);
  padding: 8px 14px;
  border-radius: 4px;
  white-space: nowrap;
  text-decoration: none;
  opacity: 0;
  pointer-events: none;
  z-index: 1;
  transition: opacity 250ms cubic-bezier(.25,.1,.25,1),
              border-color 200ms,
              background 200ms;
}

.card-cta .svg-icon { font-size: 10px; }

.card:hover .card-arrow { opacity: 0; pointer-events: none; }
.card:hover .card-cta   { opacity: 1; pointer-events: auto; }
.card-cta:hover { background: rgba(255,255,255,0.08); border-color: rgba(245,244,240,0.6); }

/* ═══ SERVICES ═══
   Owned by src/components/ServicesSection.astro (scoped styles).
   The old .services-section / .s-* / .srow* rules were removed with the
   "Five ways I can help" markup. */

/* ═══ ABOUT ═══
   Warm-paper band (--bg-light) so it reads as its own chapter between the
   white Services band and the dark Testimonials. Light background → class
   is in SiteNav's light-flip observer list. */
.about-section {
  background: var(--bg-light, #F6F3EC);
  padding: 120px var(--shell-pad);
}

.about-inner {
  max-width: var(--shell-max);
  margin: 0 auto;
}

.a-label {
  font-family: var(--body);
  font-size: var(--type-eyebrow-size);
  font-weight: var(--type-eyebrow-weight);
  letter-spacing: var(--type-eyebrow-track);
  text-transform: var(--type-eyebrow-transform);
  color: var(--type-eyebrow-color);
  margin-bottom: 12px;
}

.a-heading {
  font-family: var(--body);
  font-size: var(--type-head-size);
  font-weight: var(--type-head-weight);
  color: var(--type-head-color);
  letter-spacing: var(--type-head-track);
  line-height: var(--type-head-leading);
  margin-bottom: 48px;
}

/* Story + facts. The facts column doubles as the future portrait slot —
   when a photo lands, it swaps in above the numbers. */
.about-cols {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  gap: clamp(40px, 6vw, 96px);
  align-items: start;
  margin-bottom: 88px;
}

.about-story p {
  font-family: var(--body);
  font-size: var(--type-body-size);
  font-weight: var(--type-body-weight);
  color: var(--type-body-color);
  line-height: var(--type-body-leading);
  margin-bottom: 20px;
  max-width: 62ch;
}
.about-story p:last-child { margin-bottom: 0; }

/* Lede reads as an opener through colour, not a second body size — all
   body copy sits on --type-body-size. */
.about-story .a-lede {
  color: var(--text-dark);
}

.about-facts {
  display: flex;
  flex-direction: column;
  gap: 28px;
  border-left: 1px solid rgba(15,16,20,0.12);
  padding-left: clamp(24px, 3vw, 48px);
}

.a-fact { display: flex; flex-direction: column; }

.a-fact-num {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(2.4rem, 4vw, 3.6rem);
  font-weight: 200;
  color: var(--text-dark);
  letter-spacing: -0.02em;
  line-height: 1;
}

.a-fact-lab {
  font-family: 'Montserrat', sans-serif;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(15,16,20,0.45);
  margin-top: 8px;
}

/* ═══ INDUSTRY EXPERIENCE ═══
   Same grid format as Studio services (ServicesSection.astro): two columns
   with the right one dropped, a hairline top rule per item with an accent
   segment that runs to full width on hover, collapsing to a single column
   in slot order below 860px. Rows are not links, so hover-only affordances
   raise no keyboard-parity issue. */
.a-label--sub { margin-bottom: 8px; }

.agrid {
  display: grid;
  grid-template-columns: 1.06fr 0.94fr;
  column-gap: clamp(28px, 4vw, 56px);
}

.acol--right { margin-top: 60px; }

.arow {
  position: relative;
  padding: 24px 16px 28px 0;
  margin-bottom: 34px;
  border-top: 1px solid rgba(15,16,20,0.13);
  transition: background 350ms ease;
}

.acol .arow:last-child { margin-bottom: 0; }

/* Per-slot accent-rule width. Class-driven, never an inline style — the
   CSP has no 'unsafe-inline' and no style-src-attr escape hatch. */
.arow--01 { --arule: 18%; }
.arow--02 { --arule: 30%; }
.arow--03 { --arule: 22%; }
.arow--04 { --arule: 36%; }
.arow--05 { --arule: 16%; }
.arow--06 { --arule: 28%; }
.arow--07 { --arule: 20%; }
.arow--08 { --arule: 34%; }
.arow--09 { --arule: 24%; }

.arule {
  position: absolute;
  top: -1px;
  left: 0;
  height: 1px;
  width: var(--arule, 20%);
  background: var(--accent);
  transition: width 550ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.arow:hover { background: #FBFAF7; }
.arow:hover .arule { width: 100%; }

.aname {
  font-family: var(--body);
  font-size: var(--type-item-size);
