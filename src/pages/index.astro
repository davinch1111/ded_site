/* ── Hero entrance: rise-up after intro wipe completes ──
   FAIL-SAFE: the hero title is CONTENT and must never be invisible because
   a script didn't run. The hidden/pre-animation state is gated on
   `html.js-hero`, added by this page's script the moment it executes —
   same pattern as the js-reveal fail-safe in Base.astro. If the script is
   blocked or fails, .js-hero never lands and the title renders visible. */
html.js-hero .hero-ey,
html.js-hero .hp-hero h1,
html.js-hero .hero-sub {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 600ms cubic-bezier(.4, 0, .2, 1),
              transform 600ms cubic-bezier(.4, 0, .2, 1);
  will-change: opacity, transform;
}
.hp-hero.intro-done .hero-ey   { transition-delay: 0ms;   }
.hp-hero.intro-done .hero-h1   { transition-delay: 120ms; }
.hp-hero.intro-done .hero-sub  { transition-delay: 240ms; }
.hp-hero.intro-done .hero-ey,
.hp-hero.intro-done .hero-h1,
.hp-hero.intro-done .hero-sub {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .hero-ey,
  .hp-hero h1,
  .hero-sub {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}

/* Hero emblem (≥901px). First pass — positions to be fine-tuned from a
   screenshot.
   • Right edge aligns to the same right content margin as the hero text
     (matching clamp), so emblem and copy share the right boundary.
   • Bottom-anchored up into the eyebrow→headline band: lifted off the text
     bottom by ~the subhead height so its top sits near the eyebrow line and
     its base near the end of the headline.
   • Height is tied to the headline scale — the headline grows on a 5vw axis,
     so the two-line block grows ~2× that; the emblem height uses a
     compatible ~10.5vw clamp so it scales in proportion with the type
     instead of ballooning, staying balanced at every width. width follows
     the SVG aspect ratio (≈0.92). */
.hero-emblem {
  position: absolute;
  right: clamp(40px, 5vw, 100px);
  bottom: clamp(186px, 6vw + 138px, 248px);
  height: clamp(140px, 10.5vw + 52px, 215px);
  width: auto;
  opacity: 0.5;
  pointer-events: none;
  user-select: none;
  z-index: 2;
}

