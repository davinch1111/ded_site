---
// ScrollCue — thin vertical line with a travelling pulse and "Scroll" label.
// Used identically on the homepage hero and the project page hero so the
// two read as the same gesture.
//
// Props
// - href:  anchor target (defaults to "#scroll-target")
// - label: text under the line (defaults to "Scroll")
//
// Self-positions absolute at bottom-centre of its nearest positioned ancestor.
// Both heroes are position:relative, so dropping this anywhere inside a hero
// will place it correctly.
interface Props {
  href?: string;
  label?: string;
  ariaLabel?: string;
}
const { href = '#scroll-target', label = 'Scroll', ariaLabel } = Astro.props;
const accessibleLabel = ariaLabel ?? `Scroll to ${label.toLowerCase()}`;
---
<a href={href} class="scroll-cue" aria-label={accessibleLabel}>
  <span class="scroll-cue-line" aria-hidden="true">
    <span class="scroll-cue-pulse"></span>
  </span>
  <span class="scroll-cue-label">{label}</span>
</a>

<style is:global>
  .scroll-cue {
    position: absolute;
    bottom: clamp(24px, 4vh, 48px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: rgba(245,244,240,0.7);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
    transition: color 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .scroll-cue-line {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    background: rgba(245,244,240,0.4);
    overflow: hidden;
  }
  .scroll-cue-pulse {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 14px;
    background: linear-gradient(180deg,
      rgba(245,244,240,0)    0%,
      rgba(245,244,240,0.95) 50%,
      rgba(245,244,240,0)    100%);
    transform: translateY(-100%);
    animation: scroll-cue-pulse 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes scroll-cue-pulse {
    0%   { transform: translateY(-100%); }
    100% { transform: translateY(calc(44px + 4px)); }
  }
  .scroll-cue-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245,244,240,0.55);
  }
  @media (hover: hover) and (pointer: fine) {
    .scroll-cue:hover { color: #F5F4F0; }
    .scroll-cue:hover .scroll-cue-line { background: rgba(245,244,240,0.6); }
    .scroll-cue:hover .scroll-cue-label { color: rgba(245,244,240,0.85); }
  }
  .scroll-cue:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-pulse { display: none; animation: none; }
  }
</style>
