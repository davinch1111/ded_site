---
import SpotlightCard from './SpotlightCard.tsx';

const TILE_COLORS = ['#3457C6', '#6E84B4', '#5A6269', '#363D43', '#4A6FB5', '#8C8270'];

interface Project {
  id: number;
  title: string;
  excerpt: string;
  disciplines: string;
  color: string;
  featuredImage: string | null;
}

const FALLBACK_PROJECTS: Project[] = [
  {
    id: 1,
    title: 'First Light Fishing',
    excerpt: 'A fishing charter in Prince Rupert run by two guys who know the water. Brand, website, and photography that makes a 4am start look worth it.',
    disciplines: 'Brand · Web · Photography · 2026',
    color: '#3457C6',
    featuredImage: null,
  },
  {
    id: 2,
    title: 'Chanvre Hemp',
    excerpt: 'A hemp line that needed to look premium on a dispensary shelf. Identity, packaging, product photography, and a launch film.',
    disciplines: 'Brand · Packaging · Photo · Video · Web · 2024',
    color: '#6E84B4',
    featuredImage: null,
  },
  {
    id: 3,
    title: 'RackOn',
    excerpt: 'An innovative rack system with a sasquatch for a mascot. We took the joke seriously and built a video campaign around it.',
    disciplines: 'Video · Brand · Mascot · 2025',
    color: '#5A6269',
    featuredImage: null,
  },
  {
    id: 4,
    title: 'Wayne Northey',
    excerpt: 'Two decades of writing on justice and faith, finally organised. A dark, readable site built around his book reviews.',
    disciplines: 'Web · Identity · 2026',
    color: '#363D43',
    featuredImage: null,
  },
  {
    id: 5,
    title: 'Innotech Windows & Doors',
    excerpt: 'Fifteen years and counting. Print, video, vehicle wraps, tradeshow booths, the lot. When they need something made, they call.',
    disciplines: 'Print · Video · Wraps · Tradeshow · Since 2008',
    color: '#4A6FB5',
    featuredImage: null,
  },
  {
    id: 6,
    title: 'Vindauga Windows',
    excerpt: 'An Innotech dealer that needed its own voice. A website and brand that borrow the quality cue without copying the parent.',
    disciplines: 'Web · Brand · 2025',
    color: '#8C8270',
    featuredImage: null,
  },
];

let projects: Project[] = FALLBACK_PROJECTS;

try {
  const res = await fetch(
    'https://davidedigerdesign.in/wp-json/wp/v2/ded_project?per_page=20&_embed',
    { signal: AbortSignal.timeout(8000) }
  );

  if (res.ok) {
    const data = await res.json() as any[];

    const mapped: Project[] = data.map((p: any, i: number) => {
      const termGroups: any[][] = p._embedded?.['wp:term'] ?? [];
      const disciplines = termGroups
        .flat()
        .filter((t: any) => t.taxonomy === 'discipline')
        .map((t: any) => (t.name as string))
        .join(' · ');

      const mediaItems: any[] = p._embedded?.['wp:featuredmedia'] ?? [];
      const featuredImage: string | null = mediaItems[0]?.source_url ?? null;

      const excerptRaw: string = p.excerpt?.rendered ?? '';
      const excerpt = excerptRaw.replace(/<[^>]+>/g, '').trim();

      return {
        id: p.id as number,
        title: (p.title?.rendered ?? 'Untitled') as string,
        excerpt,
        disciplines: disciplines || 'Design · 2026',
        color: TILE_COLORS[i % TILE_COLORS.length],
        featuredImage,
      };
    });

    if (mapped.length > 0) projects = mapped;
  }
} catch {
  // WP unreachable — use fallback
}
---

<section class="work" id="work">
  <div class="wrap">
    <div class="work-head">
      <span class="lab">Selected work</span>
      <span class="lab">Tap a project</span>
    </div>
    <h2>A handful of recent projects</h2>

    <div class="detail" id="ded-detail">
      <div class="panel">
        <div class="pimg" id="ded-pimg">
          <span class="lab pimg-placeholder">Project hero / video</span>
        </div>
        <div class="pbody">
          <button class="x" id="ded-x" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
          </button>
          <div class="lab" id="ded-pmeta" style="color:var(--taupe);"></div>
          <div class="pname" id="ded-pname"></div>
          <p id="ded-pblurb"></p>
          <a class="btn" href="#contact" id="ded-pcta">
            Start a project <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>

    <div class="grid" id="ded-grid">
      {projects.map(p => (
        <SpotlightCard client:load>
          <div
            class="tile"
            data-n={p.title}
            data-m={p.disciplines}
            data-c={p.color}
            data-b={p.excerpt}
            data-img={p.featuredImage ?? ''}
          >
            {p.featuredImage
              ? <img src={p.featuredImage} alt={p.title} class="fill-img" loading="lazy" />
              : <div class="fill" style={`background:${p.color};`}></div>
            }
            <div class="cap">
              <div class="t">{p.title}</div>
              <div class="m lab">{p.disciplines}</div>
            </div>
          </div>
        </SpotlightCard>
      ))}
    </div>
  </div>
</section>

<style>
  .work { padding: 80px 0 70px; background: var(--bg-dark); }

  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .work h2 {
    font-family: var(--mid);
    font-weight: 300;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  /* ── Expand panel ── */
  .detail {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 440ms cubic-bezier(.22,.61,.36,1), opacity 320ms ease-out, margin 320ms ease-out;
  }

  .detail.open {
    max-height: 680px;
    opacity: 1;
    margin-bottom: 18px;
  }

  .panel {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    border-radius: 0;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .pimg {
    position: relative;
    min-height: 320px;
    background: var(--bg-mid);
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    padding: 16px;
  }

  .pimg-placeholder {
    color: var(--text-secondary);
  }

  .pimg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pbody {
    background: var(--bg-surface);
    padding: 34px 32px;
    position: relative;
  }

  .pbody .x {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    font-size: 20px;
  }

  .pname {
    font-family: var(--disp);
    font-size: 28px;
    font-weight: 300;
    color: var(--text-primary);
    line-height: 1.1;
    margin: 10px 0 16px;
  }

  .pbody p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    font-weight: 300;
    margin-bottom: 26px;
  }

  /* ── Asymmetric Porsche grid — first tile 2×2 ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  :global(.spotlight-card) {
    display: block;
  }

  :global(.spotlight-card:first-child) {
    grid-column: span 2;
    grid-row: span 2;
  }

  :global(.spotlight-card:first-child) .tile {
    height: 100%;
    min-height: 484px;
  }

  /* ── Tiles ── */
  .tile {
    position: relative;
    height: 240px;
    border-radius: 0;
    overflow: hidden;
    cursor: pointer;
    background: var(--bg-surface);
    transition: transform 0.4s cubic-bezier(.25,.1,.25,1),
                opacity   0.4s cubic-bezier(.25,.1,.25,1);
  }

  /* Porsche hover: hovered tile scales up, all others dim and pull back */
  .grid:has(.tile:hover) .tile:not(:hover) {
    opacity: 0.4;
    transform: scale(0.98);
  }

  .tile:hover {
    transform: scale(1.06);
  }

  .tile.active { outline: 2px solid var(--accent); outline-offset: -2px; }

  .fill {
    position: absolute;
    inset: 0;
  }

  .fill-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(.25,.1,.25,1);
  }

  .tile:hover .fill-img { transform: scale(1.03); }

  /* Cap fades in on hover */
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(3,4,14,0.80) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(.25,.1,.25,1);
  }

  .tile:hover .cap,
  .tile.active .cap {
    opacity: 1;
  }

  .cap .t {
    font-family: var(--disp);
    font-size: 20px;
    font-weight: 300;
    color: var(--text-primary);
  }

  .cap .m {
    color: var(--text-secondary);
    margin-top: 6px;
    font-size: 10px;
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    :global(.spotlight-card:first-child) {
      grid-column: span 2;
      grid-row: span 1;
    }
    :global(.spotlight-card:first-child) .tile {
      height: 240px;
      min-height: unset;
    }
  }

  @media (max-width: 680px) {
    .grid { grid-template-columns: 1fr; }
    .panel { grid-template-columns: 1fr; }
    .detail.open { max-height: 1000px; }
    .work { padding-top: 44px; padding-bottom: 46px; }
    :global(.spotlight-card:first-child) {
      grid-column: span 1;
      grid-row: span 1;
    }
    :global(.spotlight-card:first-child) .tile {
      height: 240px;
      min-height: unset;
    }
  }
</style>

<script>
  // Attach after DOM ready — SpotlightCard SSR preserves .tile elements in initial HTML
  const grid = document.getElementById('ded-grid');
  const det = document.getElementById('ded-detail');
  const pimg = document.getElementById('ded-pimg') as HTMLElement;
  const pn = document.getElementById('ded-pname') as HTMLElement;
  const pm = document.getElementById('ded-pmeta') as HTMLElement;
  const pb = document.getElementById('ded-pblurb') as HTMLElement;
  let cur: Element | null = null;

  function openPanel(t: HTMLElement) {
    grid!.querySelectorAll('.tile').forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    cur = t;

    // Step 8 fix: read all data-* attributes explicitly
    pn.textContent = t.getAttribute('data-n') ?? '';
    pm.textContent = t.getAttribute('data-m') ?? '';
    pb.textContent = t.getAttribute('data-b') ?? '';

    const imgUrl = t.getAttribute('data-img') ?? '';
    const tileColor = t.getAttribute('data-c') ?? '#3457C6';
    const placeholder = pimg.querySelector('.pimg-placeholder') as HTMLElement | null;
    const existingImg = pimg.querySelector('img');

    if (imgUrl) {
      if (existingImg) {
        existingImg.setAttribute('src', imgUrl);
      } else {
        const img = document.createElement('img');
        img.src = imgUrl;
        img.alt = pn.textContent;
        img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;';
        pimg.appendChild(img);
      }
      if (placeholder) placeholder.style.display = 'none';
      pimg.style.background = 'transparent';
    } else {
      pimg.style.background = tileColor;
      if (existingImg) existingImg.remove();
      if (placeholder) placeholder.style.display = '';
    }

    det!.classList.add('open');
    setTimeout(() => det!.scrollIntoView({ behavior: 'smooth', block: 'center' }), 120);
  }

  function closePanel() {
    det!.classList.remove('open');
    if (cur) { cur.classList.remove('active'); cur = null; }
  }

  // Use event delegation — works whether tiles are direct children or wrapped in SpotlightCard
  grid?.addEventListener('click', (e) => {
    const tile = (e.target as Element).closest('.tile') as HTMLElement | null;
    if (!tile) return;
    if (cur === tile) { closePanel(); return; }
    openPanel(tile);
  });

  document.getElementById('ded-x')?.addEventListener('click', closePanel);
</script>
