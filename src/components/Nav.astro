---
<nav class="ded-nav" id="ded-nav">
  <div class="brand">
    <span class="badge">DED</span>
    <span class="wordmark">DAVID <strong>EDIGER</strong> DESIGN</span>
  </div>
  <div class="menu lab">
    <a href="#work">Work</a>
    <span class="ddwrap">
      <a href="#services">Services <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i></a>
      <span class="dd">
        <a href="#services">Print</a>
        <a href="#services">Web</a>
        <a href="#services">Video</a>
        <a href="#services">Photo</a>
        <a href="#services">Audio</a>
      </span>
    </span>
    <a href="#about">About</a>
    <a href="#contact" class="contact-link">Contact</a>
  </div>
  <button class="burger" id="ded-burger" aria-label="Open menu">
    <i class="fa-solid fa-bars"></i>
  </button>
</nav>

<div class="mobmenu" id="ded-mobmenu">
  <button class="mobclose" id="ded-mobclose" aria-label="Close menu">
    <i class="fa-solid fa-xmark"></i>
  </button>
  <a href="#work">Work</a>
  <a href="#services">Services</a>
  <a href="#services" class="sub">Print · Web · Video · Photo · Audio</a>
  <a href="#about">About</a>
  <a href="#contact">Contact</a>
</div>

<style>
  .ded-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    /* Default: transparent dark gradient — works over dark hero/work/testimonials/footer */
    background: linear-gradient(to bottom, rgba(3,4,14,0.8) 0%, transparent 100%);
    border-bottom: none;
    transition: background 300ms cubic-bezier(.25,.1,.25,1),
                border-color 300ms cubic-bezier(.25,.1,.25,1);
  }

  /* Light section state — flips when over Contact (#ffffff) */
  .ded-nav.nav--light {
    background: rgba(246, 243, 236, 0.92);
    border-bottom: 0.5px solid rgba(10,10,15,0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* ── Brand ── */
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 27px;
    border: 1.5px solid rgba(245,244,240,0.9);
    border-radius: 5px 5px 9px 9px;
    font-family: var(--mid);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: rgba(245,244,240,0.9);
    transition: border-color 300ms cubic-bezier(.25,.1,.25,1),
                color 300ms cubic-bezier(.25,.1,.25,1);
  }

  .nav--light .badge {
    border-color: var(--accent);
    color: var(--accent);
  }

  .wordmark {
    font-family: var(--mid);
    font-size: 15px;
    font-weight: 400;
    color: rgba(245,244,240,0.9);
    letter-spacing: 0.08em;
    transition: color 300ms cubic-bezier(.25,.1,.25,1);
  }

  .nav--light .wordmark { color: var(--text-dark); }

  /* ── Desktop menu ── */
  .menu {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .menu a {
    color: rgba(245,244,240,0.85);
    text-decoration: none;
    cursor: pointer;
    transition: color 300ms cubic-bezier(.25,.1,.25,1);
  }

  .nav--light .menu a { color: rgba(10,10,15,0.65); }

  .menu .contact-link { color: rgba(245,244,240,0.95); }
  .nav--light .menu .contact-link { color: var(--accent); }

  /* ── Dropdown ── */
  .ddwrap { position: relative; }
  .ddwrap > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .dd {
    position: absolute;
    top: 26px;
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    background: #fff;
    border: 1px solid rgba(10,10,15,0.1);
    border-radius: 4px;
    padding: 8px;
    min-width: 140px;
    opacity: 0;
    visibility: hidden;
    transition: all 200ms cubic-bezier(.25,.1,.25,1);
    box-shadow: 0 8px 24px rgba(3,4,14,0.16);
  }

  .ddwrap:hover .dd {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dd a {
    display: block;
    padding: 8px 12px;
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
    border-radius: 2px;
    color: var(--text-dark) !important;
    transition: background 0.2s ease-out;
  }

  .dd a:hover {
    background: var(--bg-light);
    color: var(--accent) !important;
  }

  /* ── Mobile burger ── */
  .burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(245,244,240,0.9);
    font-size: 24px;
    line-height: 1;
    transition: color 300ms cubic-bezier(.25,.1,.25,1);
  }

  .nav--light .burger { color: var(--text-dark); }

  /* ── Mobile overlay ── */
  .mobmenu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--bg-dark);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px;
    gap: 6px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 260ms cubic-bezier(.25,.1,.25,1);
  }

  .mobmenu.open {
    opacity: 1;
    visibility: visible;
  }

  .mobmenu a {
    font-family: var(--disp);
    font-size: 30px;
    font-weight: 300;
    color: var(--text-primary);
    text-decoration: none;
    padding: 8px 0;
  }

  .mobmenu a.sub {
    font-family: var(--body);
    font-size: 15px;
    font-weight: 300;
    color: var(--text-secondary);
    padding-left: 14px;
  }

  .mobclose {
    position: absolute;
    top: 24px;
    right: 30px;
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 28px;
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .ded-nav { padding-left: 28px; padding-right: 28px; }
  }

  @media (max-width: 680px) {
    .menu { display: none; }
    .burger { display: block; }
    .ded-nav { padding-left: 20px; padding-right: 20px; }
  }
</style>

<script>
  const nav = document.getElementById('ded-nav');
  const burger = document.getElementById('ded-burger');
  const mob = document.getElementById('ded-mobmenu');
  const mobx = document.getElementById('ded-mobclose');

  // Mobile menu
  burger?.addEventListener('click', () => mob?.classList.add('open'));
  mobx?.addEventListener('click', () => mob?.classList.remove('open'));
  mob?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mob!.classList.remove('open')));

  // Toggle nav--light when scrolled over any light-bg section (Contact = white)
  const lightSections = document.querySelectorAll('.contact');
  if (nav && lightSections.length) {
    const lightSet = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) lightSet.add(entry.target);
        else lightSet.delete(entry.target);
        nav.classList.toggle('nav--light', lightSet.size > 0);
      });
    }, {
      rootMargin: '-60px 0px -80% 0px',
      threshold: 0,
    });
    lightSections.forEach(s => io.observe(s));
  }
</script>
