---
const chips = ['Print', 'Web', 'Video', 'Photo', 'Audio', 'Not sure yet'];
---
<section class="contact" id="contact">
  <div class="wrap">
    <div class="inner">
      <span class="lab eyebrow">Start a project</span>
      <h2>Tell me what you're building</h2>
      <p class="sub">I take on a small number of new projects each year. A few quick questions and I'll know if I'm the right fit.</p>
      <form class="form" action="mailto:info@davidedigerdesign.com" method="get" enctype="text/plain">
        <div class="frow">
          <input class="inp" type="text" name="name" placeholder="Your name" required />
          <input class="inp" type="email" name="email" placeholder="Email" required />
        </div>
        <input class="inp" type="text" name="company" placeholder="Business or company" style="margin-bottom:18px;" />

        <div class="flabel">What can I help with?</div>
        <div class="chips">
          {chips.map((chip, i) => (
            <span class:list={['chip', { on: i === 0 }]} data-chip>{chip}</span>
          ))}
        </div>

        <div class="frow">
          <div>
            <div class="flabel" style="margin-bottom:8px;">Budget</div>
            <select class="inp" name="budget">
              <option>Under $5,000</option>
              <option>$5,000 – $15,000</option>
              <option>$15,000 – $40,000</option>
              <option>$40,000+</option>
              <option>Let's talk</option>
            </select>
          </div>
          <div>
            <div class="flabel" style="margin-bottom:8px;">Timeline</div>
            <select class="inp" name="timeline">
              <option>As soon as possible</option>
              <option>1 – 3 months</option>
              <option>3 – 6 months</option>
              <option>Flexible</option>
            </select>
          </div>
        </div>

        <textarea class="inp" name="description" rows="4"
          placeholder="Tell me about the project. What does success look like?"
          style="margin:14px 0 24px;resize:vertical;"></textarea>

        <button class="btn-submit" type="submit">
          Send it over <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: clamp(48px, 5vw, 96px) 0;
    background: #ffffff;
  }

  .inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .eyebrow {
    color: rgba(10,10,15,0.45);
    display: block;
    margin-bottom: 12px;
  }

  .contact h2 {
    font-family: var(--disp);
    color: var(--text-dark);
    font-weight: 400;
    margin-bottom: 12px;
  }

  .sub {
    font-size: 15px;
    color: var(--text-dark);
    font-weight: 300;
    opacity: 0.6;
    max-width: 520px;
    margin-bottom: 36px;
    line-height: 1.65;
  }

  .form { width: 100%; }

  .frow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }

  .flabel {
    font-family: var(--body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(10,10,15,0.45);
    margin-bottom: 10px;
  }

  .inp {
    width: 100%;
    font-family: var(--body);
    font-size: 14px;
    padding: 13px 15px;
    border: 1px solid rgba(10,10,15,0.15);
    border-radius: 4px;
    background: #fff;
    color: var(--text-dark);
    transition: border-color 0.25s cubic-bezier(.25,.1,.25,1);
  }

  .inp:focus {
    outline: none;
    border-color: var(--accent);
  }

  .inp::placeholder { color: rgba(10,10,15,0.3); }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0 0 24px;
  }

  .chip {
    font-family: var(--body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.04em;
    padding: 8px 16px;
    border: 1px solid rgba(10,10,15,0.2);
    border-radius: 2px;
    color: rgba(10,10,15,0.6);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(.25,.1,.25,1);
    user-select: none;
  }

  .chip:hover, .chip.on {
    background: var(--text-dark);
    border-color: var(--text-dark);
    color: var(--text-primary);
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--text-dark);
    color: #F5F4F0;
    font-family: var(--body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    transition: opacity 0.25s cubic-bezier(.25,.1,.25,1), transform 120ms ease-out;
  }

  .btn-submit:hover { opacity: 0.8; }
  .btn-submit:active { transform: scale(0.97); }

  @media (max-width: 680px) {
    .frow { grid-template-columns: 1fr; }
    .contact { padding-top: 44px; padding-bottom: 46px; }
  }
</style>

<script>
  document.querySelectorAll('[data-chip]').forEach(c => {
    c.addEventListener('click', () => c.classList.toggle('on'));
  });
</script>
