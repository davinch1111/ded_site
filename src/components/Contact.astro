---
const chips = ['Print', 'Web', 'Video', 'Photo', 'Audio', 'Not sure yet'];
---
<section class="contact" id="contact">
  <div class="wrap">
    <span class="lab" style="color:var(--taupe);">Start a project</span>
    <h2>Tell me what you're building</h2>
    <p class="sub">I take on a small number of new projects each year. A few quick questions and I'll know if I'm the right fit.</p>
    <form class="form" action="mailto:info@davidedigerdesign.com" method="get" enctype="text/plain">
      <div class="frow">
        <input class="inp" type="text" name="name" placeholder="Your name" required />
        <input class="inp" type="email" name="email" placeholder="Email" required />
      </div>
      <input class="inp" type="text" name="company" placeholder="Business or company" style="margin-bottom:18px;" />

      <div class="lab" style="color:var(--slate);">What can I help with?</div>
      <div class="chips">
        {chips.map((chip, i) => (
          <span class:list={['chip', { on: i === 0 }]} data-chip>{chip}</span>
        ))}
      </div>

      <div class="frow">
        <div>
          <div class="lab" style="color:var(--slate);margin-bottom:8px;">Budget</div>
          <select class="inp" name="budget">
            <option>Under $5,000</option>
            <option>$5,000 – $15,000</option>
            <option>$15,000 – $40,000</option>
            <option>$40,000+</option>
            <option>Let's talk</option>
          </select>
        </div>
        <div>
          <div class="lab" style="color:var(--slate);margin-bottom:8px;">Timeline</div>
          <select class="inp" name="timeline">
            <option>As soon as possible</option>
            <option>1 – 3 months</option>
            <option>3 – 6 months</option>
            <option>Flexible</option>
          </select>
        </div>
      </div>

      <textarea class="inp" name="description" rows="4"
        placeholder="Tell me about the project. What does success look like?"
        style="margin:14px 0 18px;resize:vertical;"></textarea>

      <a class="btn" href="mailto:info@davidedigerdesign.com">
        Send it over <i class="fa-solid fa-arrow-right"></i>
      </a>
    </form>
  </div>
</section>

<style>
  .contact {
    padding: 64px 0;
    background: #fff;
  }

  .contact h2 {
    font-family: var(--disp);
    font-size: clamp(26px, 3.4vw, 38px);
    color: var(--slatedk);
    font-weight: 400;
    margin: 8px 0 10px;
  }

  .sub {
    font-size: 15px;
    color: var(--slate);
    font-weight: 300;
    max-width: 480px;
    margin-bottom: 28px;
  }

  .form { max-width: 680px; }

  .frow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }

  .inp {
    width: 100%;
    font-family: var(--body);
    font-size: 14px;
    padding: 13px 15px;
    border: 1px solid #d8d2c4;
    border-radius: 7px;
    background: #fff;
    color: var(--slatedk);
  }

  .inp::placeholder { color: #aaa39a; }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 10px 0 22px;
  }

  .chip {
    font-size: 13px;
    padding: 8px 15px;
    border: 1px solid var(--taupe);
    border-radius: 22px;
    color: var(--slate);
    cursor: pointer;
    transition: all 180ms ease-out;
    user-select: none;
  }

  .chip:hover, .chip.on {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  @media (max-width: 680px) {
    .frow { grid-template-columns: 1fr; }
    .contact { padding-top: 44px; padding-bottom: 46px; }
  }
</style>

<script>
  document.querySelectorAll('[data-chip]').forEach(c => {
    c.addEventListener('click', () => c.classList.toggle('on'));
  });
</script>
