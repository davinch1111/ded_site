---
import PerspectiveMarquee from './PerspectiveMarquee.tsx';
---
<header class="hero">
  <!-- TODO: wire showreel — add class="hero-video" to the video element
    <video autoplay muted loop playsinline poster="POSTER.jpg" class="hero-video">
      <source src="SHOWREEL.mp4" type="video/mp4">
    </video>
  -->
  <div class="scrim"></div>
  <div class="reel lab"><i class="fa-solid fa-play"></i> Showreel</div>
  <div class="inner">
    <div class="ey lab">David Ediger · Creative Director</div>
    <h1>Brands that<br>refuse to blend in</h1>
    <p>Twenty-three years of print, web, video, photo, and audio. Some of these clients have stayed since 2008.</p>
  </div>
  <div class="pmarquee-overlay">
    <PerspectiveMarquee client:load />
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--bg-dark);
  }

  @keyframes kenBurns {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }

  /* Applied when real video is wired in */
  :global(.hero-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: kenBurns 8s linear forwards;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(3,4,14,0.85) 0%, rgba(3,4,14,0.1) 60%);
    z-index: 1;
  }

  .reel {
    position: absolute;
    top: 90px;
    right: clamp(16px, 4vw + 4px, 80px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    z-index: 2;
  }

  .inner {
    position: absolute;
    bottom: clamp(48px, 3vw + 38px, 96px);
    left: clamp(16px, 4vw + 4px, 80px);
    right: clamp(16px, 4vw + 4px, 80px);
    z-index: 2;
    max-width: 720px;
  }

  .ey {
    margin-bottom: 20px;
  }

  h1 {
    font-family: var(--disp);
    font-weight: 200;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  p {
    font-family: var(--body);
    font-size: clamp(13px, 1.3vw, 16px);
    font-weight: 300;
    color: rgba(245, 244, 240, 0.7);
    max-width: 480px;
    line-height: 1.65;
  }

  .pmarquee-overlay {
    position: absolute;
    bottom: 20%;
    left: 0;
    right: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }

  @media (max-width: 680px) {
    .reel { display: none; }
    .inner { right: clamp(16px, 4vw + 4px, 80px); }
  }
</style>
