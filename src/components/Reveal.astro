---
// Reveal — shared scroll-reveal behaviour for homepage + work pages.
// Emits the global `.reveal` / `.is-visible` CSS and the IntersectionObserver
// that flips elements visible as they enter the viewport. Drop <Reveal />
// once per page; Astro dedupes the bundled <script> across instances.
//
// Any element with class `reveal` rises + fades in on first intersection.
// prefers-reduced-motion strips the transform and keeps a short opacity fade.
---
<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 800ms cubic-bezier(0.4, 0, 0.2, 1),
                transform 800ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      transition: opacity 240ms ease;
      transform: none !important;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
  reveals.forEach((el) => io.observe(el));
</script>
