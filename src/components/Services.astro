---
const services = [
  {
    name: 'Print',
    desc: 'Logos, brand systems, packaging, signage, vehicle wraps, tradeshow booths. The work people can hold and walk up to.',
    gradient: 'linear-gradient(135deg, #2c3240 0%, #4a5269 100%)',
  },
  {
    name: 'Web',
    desc: 'Websites that load fast and convert, plus the social campaigns to feed them. WordPress builds with the back end actually organised.',
    gradient: 'linear-gradient(135deg, #2A47A0 0%, #3457C6 100%)',
  },
  {
    name: 'Video',
    desc: 'Cinematic shoots, editing, colour, motion graphics. From hero films down to social cuts.',
    gradient: 'linear-gradient(135deg, #0f0f1a 0%, #363D43 100%)',
  },
  {
    name: 'Photo',
    desc: 'Product, portrait, and conceptual photography. Images built to sell, not just to sit there.',
    gradient: 'linear-gradient(135deg, #4a5a80 0%, #6E84B4 100%)',
  },
  {
    name: 'Audio',
    desc: 'Music, soundtracks, sound design. Twenty years behind instruments, put to work on your brand.',
    gradient: 'linear-gradient(135deg, #6b5f4e 0%, #A59A88 100%)',
  },
];
---
<section class="services" id="services">
  <div class="wrap">
    <span class="lab" style="color:var(--taupe);">What I make</span>
    <h2>Five ways I can help</h2>
    <div class="srows">
      {services.map(s => (
        <a class="srow" href="#contact">
          <div class="srow-bg" style={`background:${s.gradient};`}></div>
          <div class="sname">{s.name}</div>
          <p>{s.desc}</p>
          <span class="ar"><i class="fa-solid fa-arrow-right"></i></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 8px 0 64px;
  }

  .services h2 {
    font-family: var(--mid);
    font-weight: 300;
    font-size: clamp(20px, 2.6vw, 28px);
    color: var(--slatedk);
    margin: 8px 0 18px;
  }

  .srows {
    border-bottom: 1px solid #e6e0d3;
  }

  .srow {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 22px 18px;
    border-top: 1px solid #e6e0d3;
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: border-color 400ms ease-out;
  }

  /* Reveal image (gradient placeholder) — clips in on hover */
  .srow-bg {
    position: absolute;
    inset: 0;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 400ms ease-out;
    z-index: 0;
  }

  .srow:hover .srow-bg {
    clip-path: inset(0 0% 0 0);
  }

  /* All row content sits above the bg */
  .sname, .srow p, .ar {
    position: relative;
    z-index: 1;
  }

  .sname {
    font-family: var(--disp);
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 300;
    color: var(--slatedk);
    transition: color 300ms ease-out;
  }

  .srow:hover .sname { color: #fff; }

  .srow p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--slate);
    font-weight: 300;
    transition: color 300ms ease-out;
  }

  .srow:hover p { color: rgba(255,255,255,0.75); }

  .ar {
    opacity: 0;
    transform: translateX(-8px);
    color: var(--taupe);
    font-size: 18px;
    transition: all 180ms ease-out;
  }

  .srow:hover .ar {
    opacity: 1;
    transform: translateX(0);
    color: rgba(255,255,255,0.8);
  }

  @media (max-width: 680px) {
    .srow {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .ar { display: none; }
  }
</style>
