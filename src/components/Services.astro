---
const services = [
  {
    name: 'Print',
    desc: 'Logos, brand systems, packaging, signage, vehicle wraps, tradeshow booths. The work people can hold and walk up to.',
    gradient: 'linear-gradient(135deg,#1a2744 0%,#3457C6 100%)',
  },
  {
    name: 'Web',
    desc: 'Websites that load fast and convert, plus the social campaigns to feed them. WordPress builds with the back end actually organised.',
    gradient: 'linear-gradient(135deg,#0a1628 0%,#1e3a8a 100%)',
  },
  {
    name: 'Video',
    desc: 'Cinematic shoots, editing, colour, motion graphics. From hero films down to social cuts.',
    gradient: 'linear-gradient(135deg,#0a0a0a 0%,#2a2a2a 100%)',
  },
  {
    name: 'Photo',
    desc: 'Product, portrait, and conceptual photography. Images built to sell, not just to sit there.',
    gradient: 'linear-gradient(135deg,#1a2a1a 0%,#2d5a27 100%)',
  },
  {
    name: 'Audio',
    desc: 'Music, soundtracks, sound design. Twenty years behind instruments, put to work on your brand.',
    gradient: 'linear-gradient(135deg,#1a0a2a 0%,#3d1c52 100%)',
  },
];
---
<section class="services" id="services">
  <div class="wrap">
    <span class="lab">What I make</span>
    <div class="srows">
      {services.map(s => (
        <a class="srow" href="#contact">
          <div class="srow-bg" style={`background:${s.gradient};`}></div>
          <div class="sname">{s.name}</div>
          <p>{s.desc}</p>
          <span class="ar"><i class="fa-solid fa-arrow-right"></i></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: clamp(48px, 5vw, 96px) 0 clamp(48px, 5vw, 80px);
    background: var(--bg-dark);
  }

  .srows {
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-top: 32px;
  }

  .srow {
    display: grid;
    grid-template-columns: minmax(200px, 32%) 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 28px 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  /* Full-bleed gradient clips in on hover — Porsche reveal */
  .srow-bg {
    position: absolute;
    inset: 0;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 500ms cubic-bezier(0.25, 0.1, 0.25, 1);
    z-index: 0;
  }

  .srow:hover .srow-bg {
    clip-path: inset(0 0% 0 0);
  }

  /* All row content sits above the bg */
  .sname, .srow p, .ar {
    position: relative;
    z-index: 1;
  }

  .sname {
    font-family: var(--disp);
    font-size: clamp(1.5rem, 2.5vw + 0.8rem, 3.5rem);
    font-weight: 300;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.1;
    transition: color 300ms cubic-bezier(.25,.1,.25,1);
  }

  .srow:hover .sname { color: #fff; }

  .srow p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    font-weight: 300;
    transition: color 300ms cubic-bezier(.25,.1,.25,1);
  }

  .srow:hover p { color: rgba(245,244,240,0.75); }

  .ar {
    opacity: 0;
    transform: translateX(-8px);
    color: rgba(255,255,255,0.8);
    font-size: 20px;
    transition: opacity 180ms ease-out, transform 180ms ease-out;
  }

  .srow:hover .ar {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 680px) {
    .srow {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .ar { display: none; }
  }
</style>
