---
const quotes = [
  {
    text: 'We have worked with David since 2008. He is dependable, professional and highly talented. He has helped us successfully brand our company.',
    name: 'Jessica Owen',
    role: 'Marketing Manager, Innotech',
  },
  {
    text: 'David has to be one of the most talented graphic designers I have ever seen. I\'ve hired hundreds of designers. His talent is head and shoulders above the rest.',
    name: 'Kim Mullin',
    role: 'Business Development',
  },
  {
    text: 'David Ediger Design is my first and only recommendation to professional business owners. His passion for design and branding is exceptional and consistent.',
    name: 'Dave Fullerton',
    role: 'Investment Manager',
  },
];
---
<section class="quotes">
  <div class="wrap">
    <span class="lab">What people say</span>
    <h2>Twenty years of working relationships</h2>
    <div class="qgrid">
      {quotes.map(q => (
        <div class="qcard">
          <div class="qmark">"</div>
          <p>{q.text}</p>
          <div class="qn">{q.name}</div>
          <div class="qr lab">{q.role}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes {
    padding: clamp(48px, 5vw, 96px) 0;
    background: var(--bg-mid);
  }

  .quotes h2 {
    font-family: var(--mid);
    font-weight: 300;
    color: var(--text-primary);
    margin: 8px 0 clamp(24px, 3vw, 40px);
  }

  .qgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .qcard {
    background: var(--bg-surface);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0;
    padding: 32px;
  }

  .qmark {
    font-family: var(--disp);
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 16px;
    user-select: none;
  }

  .qcard p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-primary);
    font-weight: 300;
    margin-bottom: 24px;
  }

  .qn {
    font-family: var(--mid);
    font-weight: 500;
    font-size: 13px;
    color: var(--text-primary);
  }

  .qr {
    color: var(--text-secondary);
    font-size: 10px;
    margin-top: 4px;
  }

  @media (max-width: 1024px) {
    .qgrid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 680px) {
    .qgrid { grid-template-columns: 1fr; gap: 4px; }
    .quotes { padding-top: 44px; padding-bottom: 46px; }
  }
</style>
