# The full Content-Security-Policy (script-src with hashes, style-src, img-src,
# etc.) is emitted per-page as a <meta> tag by Astro's security.csp — see
# astro.config.mjs. That meta tag is the single effective script-src.
# This header carries ONLY frame-ancestors, which a meta CSP cannot express.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'self'
